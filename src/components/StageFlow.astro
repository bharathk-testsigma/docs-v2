---
/**
 * The journey diagram on each product home: one unit of work moving through
 * five stages, each stage a link into the section that documents it.
 *
 * One component for both homes. It was two -- an .astro file for Suite and
 * ninety lines of inline SVG in arcus/home.mdx -- drawing the same five cards
 * with the same geometry and two copies of every rule.
 *
 * A component rather than markup in the page for a second reason: a home
 * page's body doubles as the source for its `.md` export, the file an LLM gets
 * from "Copy page", so layout that carries no prose is better kept out of it.
 *
 * Hovering (or tabbing to) a stage swaps the caption underneath. That is done
 * with :has() rather than a script: the only state is which stage the pointer
 * is over, which CSS already knows.
 *
 * Stage words live in src/data/flow-stages.mjs.
 */
import { withBase } from '../lib/base';
interface Stage {
	label: string;
	tone: string;
	href: string;
	rows: string[];
	foot: string;
	cap: string;
}
interface Props {
	flow: {
		aria: string;
		rest: string;
		loop: { from: number; to: number; label: string };
		stages: Stage[];
	};
}
const { flow } = Astro.props;
const { stages, loop } = flow;

// One 245px column per stage: a 200px card, then the 45px connector to the next.
const STRIDE = 245;
const x = (i: number) => 10 + i * STRIDE;
const cx = (i: number) => x(i) + 100;
---

<div class="fl">
	<div class="fl-scroll">
		<svg viewBox="0 0 1200 372" role="img" aria-label={flow.aria}>
			{
				/* Connectors, each with a dot travelling in the direction of the work.
				   The dot takes the colour of the stage it is arriving at. */
				stages.slice(1).map((s, i) => (
					<Fragment>
						<path id={`fl-e${i}`} class="fl-edge" d={`M ${x(i) + 200} 165 H ${x(i + 1)}`} />
						<circle class={`fl-pulse fl-t-${s.tone}`} r="4">
							<animateMotion dur="2.6s" begin={`${i * 0.55}s`} repeatCount="indefinite">
								<mpath href={`#fl-e${i}`} />
							</animateMotion>
							<animate
								attributeName="opacity"
								values="0;1;1;0"
								dur="2.6s"
								begin={`${i * 0.55}s`}
								repeatCount="indefinite"
							/>
						</circle>
					</Fragment>
				))
			}

			{/* The one stage that feeds back rather than forward. */}
			<path id="fl-loop" class="fl-loop" d={`M ${cx(loop.from)} 260 V 320 H ${cx(loop.to)} V 260`} />
			<circle class={`fl-pulse fl-t-${stages[loop.to].tone}`} r="3.5">
				<animateMotion dur="4.2s" repeatCount="indefinite"><mpath href="#fl-loop" /></animateMotion>
			</circle>
			<text
				x={(cx(loop.from) + cx(loop.to)) / 2}
				y="342"
				text-anchor="middle"
				class="fl-loop-t"
			>
				{loop.label}
			</text>

			{
				stages.map((s, i) => (
					<a class={`fl-z fl-t-${s.tone}`} id={`fl-z${i + 1}`} href={withBase(s.href)}>
						<text x={cx(i)} y="56" text-anchor="middle" class="fl-label">
							{s.label}
						</text>
						<rect x={x(i)} y="70" width="200" height="190" rx="16" class="fl-box" />
						{s.rows.map((row, j) => (
							<Fragment>
								<rect x={x(i) + 16} y={92 + j * 42} width="168" height="38" rx="8" class="fl-row" />
								<text x={cx(i)} y={116 + j * 42} text-anchor="middle" class="fl-row-t">
									{row}
								</text>
							</Fragment>
						))}
						<text x={cx(i)} y="243" text-anchor="middle" class="fl-foot">
							{s.foot}
						</text>
					</a>
				))
			}
		</svg>
	</div>

	{/* Stacked in one grid cell so the block never changes height as it swaps. */}
	<p class="fl-cap">
		<span class="fl-cap-d">{flow.rest}</span>
		{stages.map((s, i) => <span class={`fl-cap-${i + 1}`}>{s.cap}</span>)}
	</p>
</div>

<style>
	.fl {
		/* Stage accents. Dark first, matching theme.css; the light values are the
		   design's. Greys come from the --ts-* tokens, so only these five need a
		   pair. */
		--fl-pink: #e58086;
		--fl-teal: #3fb6bf;
		--fl-purple: #a78bfa;
		--fl-blue: #8ab4f8;
		--fl-green: #4bbd8a;
	}
	:root[data-theme='light'] .fl {
		--fl-pink: #b2506a;
		--fl-teal: #0b7f88;
		--fl-purple: #5c27f5;
		--fl-blue: #2563eb;
		--fl-green: #00875a;
	}
	/* One --tone per stage, set by the tone name in the data. */
	.fl-t-neutral { --tone: var(--ts-tx2); }
	.fl-t-pink { --tone: var(--fl-pink); }
	.fl-t-teal { --tone: var(--fl-teal); }
	.fl-t-purple { --tone: var(--fl-purple); }
	.fl-t-blue { --tone: var(--fl-blue); }
	.fl-t-green { --tone: var(--fl-green); }

	/* Below ~800px the 1200-unit viewBox shrinks the labels past legibility, so
	   the diagram scrolls sideways instead of scaling down. */
	.fl-scroll {
		overflow-x: auto;
		scrollbar-width: thin;
	}
	.fl svg {
		display: block;
		width: 100%;
		min-width: 760px;
		height: auto;
	}

	.fl-pulse { fill: var(--tone); }
	.fl-edge {
		fill: none;
		stroke: var(--ts-bd);
		stroke-width: 1.4;
		stroke-linecap: round;
	}
	.fl-loop {
		fill: none;
		stroke: var(--ts-bd);
		stroke-width: 1.3;
		stroke-dasharray: 5 5;
	}
	.fl-loop-t {
		font-size: 15px;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		fill: var(--ts-tx3);
	}

	/* theme.css underlines every anchor in .sl-markdown-content, and an SVG
	   <text> inherits that from the <a> wrapping it. :global on the outer class
	   because it belongs to the page, not this component. */
	:global(.sl-markdown-content) .fl-z,
	:global(.sl-markdown-content) .fl-z:hover {
		cursor: pointer;
		text-decoration: none;
	}
	.fl-label {
		font-size: 15px;
		font-weight: 700;
		letter-spacing: 0.09em;
		text-transform: uppercase;
		fill: var(--tone);
	}
	.fl-box {
		fill: var(--ts-bg);
		stroke: var(--ts-bd);
		transition: stroke 200ms, fill 200ms;
	}
	.fl-z:hover .fl-box,
	.fl-z:focus-visible .fl-box {
		stroke: var(--tone);
		fill: var(--ts-panel);
	}
	/* One step darker than the card behind them: on --ts-panel with a
	   --ts-bd-soft edge the rows barely separated from the card at all. */
	.fl-row {
		fill: var(--ts-hover);
		stroke: var(--ts-bd);
	}
	.fl-row-t {
		font-size: 17px;
		fill: var(--ts-tx2);
	}
	.fl-foot {
		font-size: 15px;
		fill: var(--ts-tx3);
	}

	.fl-cap {
		display: grid;
		margin: 18px auto 0;
		max-width: 70ch;
		text-align: center;
		font-size: 14.5px;
		line-height: 23px;
		color: var(--ts-tx2);
		text-wrap: pretty;
	}
	.fl-cap > span {
		grid-area: 1 / 1;
		opacity: 0;
		transition: opacity 150ms;
	}
	/* Outranks the reset above, which is (0,1,1) on .fl-cap > span. */
	.fl-cap > .fl-cap-d {
		opacity: 1;
	}
	.fl:has(.fl-z:is(:hover, :focus-visible)) .fl-cap-d {
		opacity: 0;
	}
	.fl:has(#fl-z1:is(:hover, :focus-visible)) .fl-cap-1,
	.fl:has(#fl-z2:is(:hover, :focus-visible)) .fl-cap-2,
	.fl:has(#fl-z3:is(:hover, :focus-visible)) .fl-cap-3,
	.fl:has(#fl-z4:is(:hover, :focus-visible)) .fl-cap-4,
	.fl:has(#fl-z5:is(:hover, :focus-visible)) .fl-cap-5 {
		opacity: 1;
	}

	@media (prefers-reduced-motion: reduce) {
		.fl-pulse {
			display: none;
		}
	}
</style>
