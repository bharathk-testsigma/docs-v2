---
/**
 * DocCard -- the card used on section overview pages.
 *
 * Starlight's <LinkCard> is a single row: title, arrow, description. This is the
 * reference design's card instead: an icon block on top, a hairline, then the
 * title and description underneath, with the whole card as one link target.
 *
 * Icons are a local map rather than a dependency. Starlight ships 20 UI icons
 * (the rest of its set is file-type glyphs for <FileTree>) and none of them fit
 * web, Salesforce, API, or desktop -- the four this site needs most. Each glyph
 * below is drawn on the same 24x24 grid at stroke 1.6, matching the inline SVGs
 * already in Header.astro and PageFeedback.astro.
 *
 * Wrap a set of these in Starlight's <CardGrid>, which lays out two per row at
 * the content column's width.
 */

/** 24x24 glyph bodies. Add one here rather than passing SVG from a content file. */
const ICONS = {
	book: '<path d="M12 6.5S9.5 4 5 4v13c4.5 0 7 2.5 7 2.5s2.5-2.5 7-2.5V4c-4.5 0-7 2.5-7 2.5Z"/><path d="M12 6.5v13"/>',
	browser: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18"/><circle cx="6.5" cy="6.5" r=".6"/><circle cx="9" cy="6.5" r=".6"/>',
	mobile: '<rect x="7" y="3" width="10" height="18" rx="2"/><path d="M10.5 18h3"/>',
	cloud: '<path d="M7 18h10a3.5 3.5 0 0 0 .2-7 5.5 5.5 0 0 0-10.5-1A3.8 3.8 0 0 0 7 18Z"/>',
	code: '<path d="m9 8-4 4 4 4"/><path d="m15 8 4 4-4 4"/>',
	monitor: '<rect x="3" y="4" width="18" height="12" rx="2"/><path d="M9 20h6"/><path d="M12 16v4"/>',
	layers: '<rect x="4" y="4" width="16" height="5" rx="1.5"/><path d="M4 13.5h16"/><path d="M4 18.5h16"/>',
	terminal: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="m7 10 2.5 2.5L7 15"/><path d="M12.5 15H17"/>',
	box: '<path d="M12 3l8 4.5v9L12 21l-8-4.5v-9L12 3Z"/><path d="M4 7.5l8 4.5 8-4.5"/><path d="M12 12v9"/>',
	tunnel: '<path d="M4 12h9"/><path d="m10 8 4 4-4 4"/><rect x="16" y="4" width="4" height="16" rx="1.5"/>',
	page: '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8l-5-5Z"/><path d="M14 3v5h5"/>',
} as const;

interface Props {
	title: string;
	href: string;
	description: string;
	icon?: keyof typeof ICONS;
}

import { withBase } from '../lib/base';

const { title, href, description, icon = 'page' } = Astro.props;

// `href` arrives as a JSX prop from MDX (<DocCard href="/suite/..."/>), which
// the rehype link plugin cannot reach -- it only sees real HTML elements, and
// JSX props never become hast nodes. Prefixing here covers every card on every
// overview page in one place.
---

<a class="ts-doc-card" href={withBase(href)}>
	<span class="ts-doc-card-art">
		<svg
			width="20"
			height="20"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="1.6"
			stroke-linecap="round"
			stroke-linejoin="round"
			aria-hidden="true"
			set:html={ICONS[icon]}
		/>
	</span>
	<span class="ts-doc-card-body">
		<span class="ts-doc-card-title">{title}</span>
		<span class="ts-doc-card-desc">{description}</span>
	</span>
</a>

<style>
	.ts-doc-card {
		display: flex;
		flex-direction: column;
		/* A fill one step off the page, as in the reference -- --ts-panel is only
		   2 shades from white in light mode and the card read as a bare outline. */
		background: var(--ts-code-bg);
		border: 1px solid var(--ts-bd);
		border-radius: 10px;
		overflow: hidden;
		text-decoration: none;
		transition:
			background 0.12s,
			border-color 0.12s;
	}
	.ts-doc-card:hover {
		background: var(--ts-hover);
	}
	.ts-doc-card:hover .ts-doc-card-title {
		color: var(--ts-ac);
	}

	/* Icon block: sized to the glyph plus its padding, ~52px. The canvas drew a
	   104px band here, which held a 20px icon in the top-left corner and 68px of
	   nothing -- at this card width it read as an empty panel above the card
	   rather than as the card's own header.
	   `flex`, not `block`: a block would add the inline line-box descender
	   under the svg, so the band would not be symmetric about the icon. */
	.ts-doc-card-art {
		display: flex;
		padding: 16px 18px;
		color: var(--ts-tx);
	}

	.ts-doc-card-body {
		display: block;
		padding: 14px 18px 18px;
		border-top: 1px solid var(--ts-bd);
	}
	.ts-doc-card-title {
		display: block;
		font-size: 0.938rem; /* 15px */
		font-weight: 550;
		letter-spacing: -0.008em;
		color: var(--ts-tx);
		margin-bottom: 6px;
	}
	.ts-doc-card-desc {
		display: block;
		font-size: 0.844rem; /* 13.5px */
		line-height: 1.55;
		color: var(--ts-tx2);
	}
</style>
