	}
	.ts-ask-panel-head {
		display: flex;
		align-items: center;
		gap: 8px;
		flex: none;
		padding: 12px 12px 12px 16px;
		border-bottom: 1px solid var(--ts-bd);
	}
	.ts-ask-panel-mark {
		display: block;
		object-fit: contain;
	}
	.ts-ask-panel-title {
		flex: 1;
		min-width: 0;
		font-size: 13px;
		font-weight: 600;
		color: var(--ts-tx);
	}
	.ts-sa-headbtn {
		display: grid;
		place-items: center;
		flex: none;
		width: 28px;
		height: 28px;
		padding: 0;
		border: none;
		border-radius: 6px;
		background: transparent;
		color: var(--ts-tx3);
		cursor: pointer;
		transition:
			background var(--ts-t) var(--ts-ease),
			color var(--ts-t) var(--ts-ease);
	}
	.ts-sa-headbtn:hover {
		background: var(--ts-hover);
		color: var(--ts-tx);
	}
	/* Nothing to clear yet: the trash is dimmed rather than removed, so the
	   header does not reflow the first time a question is asked. */
	.ts-ask-panel:not(:has(.ts-sa-msg)) #ts-sa-clear {
		opacity: 0.35;
		pointer-events: none;
	}

	/* ---- empty state: mark, time-of-day greeting, one line under it ----
	   Centred in the thread, which is why the thread is a flex column: the
	   greeting sits in the middle of the empty panel, and the chips + composer
	   ride at the bottom the way they do once a conversation exists. */
	.ts-sa-hello {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		flex: 1;
		gap: 4px;
		padding: 24px 8px;
		text-align: center;
	}
	.ts-sa-hello-mark {
		position: relative;
		display: grid;
		place-items: center;
		width: 64px;
		height: 64px;
		margin-bottom: 12px;
		border-radius: 50%;
		/* A teal tint, not --ts-ai-wash: the gear is brand teal, and the pink
		   AI wash behind it read as two brands fighting. Translucent, so it
		   sits correctly on the panel in either theme. */
		background: rgba(1, 189, 167, 0.11);
	}
	/* The mark itself is static (it is the site favicon); only the glint moves. */
	.ts-sa-hello-gear {
		display: block;
	}
	/* The glint, riding the mark's upper right. */
	.ts-sa-hello-spark {
		position: absolute;
		top: 7px;
		right: 8px;
		width: 13px;
		height: 13px;
		/* Brand teal, matching the gear -- the pink AI accent made the glint
		   read as a second mark stuck onto the first. */
		color: #01bda7;
		animation: ts-sa-twinkle 3.2s var(--ts-ease) infinite;
	}
	@keyframes ts-sa-twinkle {
		0%,
		100% {
			transform: scale(0.65) rotate(0deg);
			opacity: 0.35;
		}
		45% {
			transform: scale(1.15) rotate(90deg);
			opacity: 1;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.ts-sa-hello-spark {
			animation: none;
		}
	}
	.ts-sa-hello-title {
		margin: 0;
		font-size: 19px;
		font-weight: 600;
		letter-spacing: -0.015em;
		color: var(--ts-tx);
		border: none;
		padding: 0;
	}
	.ts-sa-hello-sub {
		margin: 0;
		font-size: 13.5px;
		line-height: 1.55;
		color: var(--ts-tx2);
	}
	/* One rule retires the greeting AND the starter chips: both are empty-state
	   furniture, and `:has` reads the thread directly, so nothing has to be
	   toggled in JS when a question is asked or the trash resets it. */
	.ts-sa-view:has(.ts-sa-msg) .ts-sa-hello,
	.ts-sa-view:has(.ts-sa-msg) .ts-sa-chips {
		display: none;
	}

	/* Conversation view */
	.ts-sa-view {
		display: flex;
		flex-direction: column;
		min-height: 24rem;
	}
	.ts-sa-view[hidden] {
		display: none;
	}
	/* In the panel the view owns the remaining height, so the thread scrolls
	   against the panel rather than against the modal's capped max-height. */
	.ts-ask-panel .ts-sa-view {
		flex: 1;
		min-height: 0;
		padding: 0 16px 12px;
	}
	.ts-ask-panel .ts-sa-thread {
		max-height: none;
	}
	.ts-sa-thread {
		display: flex;
		flex-direction: column;
		flex: 1;
		overflow-y: auto;
		max-height: min(58vh, 33rem);
		scrollbar-width: thin;
	}
	/* No rules between turns: the question's bubble is the divider. */
	.ts-sa-msg {
		display: flex;
		padding-block: 0.9rem;
	}
	.ts-sa-msg-user {
		justify-content: flex-end;
		padding-block: 1.1rem 0.5rem;
	}
	/* The question, as a bubble on the reader's side. Capped at 85% so a long
	   question still reads as a bubble and not as a full-width block. */
	.ts-sa-msg-user .ts-sa-q {
		max-width: 85%;
		padding: 9px 14px;
		border-radius: 14px;
		background: var(--ts-hover);
		font-size: 13.5px;
		line-height: 1.5;
		color: var(--ts-tx);
	}
	.ts-sa-msg-body {
		flex: 1;
		min-width: 0;
		font-size: var(--sl-text-sm);
		line-height: 1.65;
		color: var(--sl-color-white);
	}
	.ts-sa-msg-body > p {
		margin: 0 0 0.4rem;
	}
	.ts-sa-msg-body > p:last-child {
		margin-bottom: 0;
	}
	.ts-sa-q {
		overflow-wrap: anywhere;
	}

	/* Thinking indicator */
	.ts-sa-think {
		display: flex;
		align-items: center;
		gap: 2px;
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
	}
	.ts-sa-think[hidden] {
		display: none;
	}
	.ts-sa-dots i {
		display: inline-block;
		width: 3px;
		height: 3px;
		border-radius: 50%;
		background: currentColor;
		margin-inline-start: 4px;
		animation: ts-sa-blink 1.2s infinite;
	}
	.ts-sa-dots i:nth-child(2) {
		animation-delay: 0.2s;
	}
	.ts-sa-dots i:nth-child(3) {
		animation-delay: 0.4s;
	}
	@keyframes ts-sa-blink {
		0%, 80%, 100% { opacity: 0.25; }
		40% { opacity: 1; }
	}

	/* Answer content: keep it monotone inside the modal */
	.ts-sa-msg .ts-ask-answer {
		font-size: var(--sl-text-sm);
	}

	/* Answer actions (copy) */
	.ts-sa-actions {
		display: flex;
		gap: 2px;
		margin-top: 0.7rem;
	}
	.ts-sa-actions[hidden] {
		display: none;
	}
	.ts-sa-act {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.7rem;
		height: 1.7rem;
		border: none;
		border-radius: 0.35rem;
		background: transparent;
		color: var(--sl-color-gray-3);
		cursor: pointer;
	}
	.ts-sa-act:hover {
		background: var(--sl-color-gray-6);
		color: var(--sl-color-white);
	}
	.ts-sa-act[aria-pressed='true'] {
		color: var(--ts-ac);
		background: var(--ts-ac-soft);
	}

	/* Sources -- a <details> ABOVE the answer ("Explored 4 pages"), collapsed.
	   They used to be four cards below every answer, which pushed the answer
	   itself off-screen on a short panel. */
	.ts-sa-sources {
		margin-bottom: 0.85rem;
	}
	.ts-sa-sources[hidden] {
		display: none;
	}
	.ts-sa-sources-head {
		display: flex;
		align-items: center;
		gap: 5px;
		width: fit-content;
		font-size: 12.5px;
		color: var(--ts-tx3);
		cursor: pointer;
		list-style: none;
	}
	.ts-sa-sources-head::-webkit-details-marker {
		display: none;
	}
	/* The caret is drawn here rather than left to the marker, so it can rotate
	   on open and sit on the text baseline in both themes. */
	.ts-sa-sources-head::after {
		content: '';
		width: 5px;
		height: 5px;
		border-right: 1.5px solid currentColor;
		border-bottom: 1.5px solid currentColor;
		transform: rotate(-45deg);
		transition: transform var(--ts-t) var(--ts-ease);
	}
	.ts-sa-sources[open] .ts-sa-sources-head::after {
		transform: rotate(45deg);
	}
	.ts-sa-sources-head:hover {
		color: var(--ts-tx);
	}
	.ts-sa-sources[open] .ts-sa-sources-head {
		margin-bottom: 0.6rem;
	}
	.ts-sa-source {
		display: block;
		padding: 0.7rem 0.9rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.6rem;
		margin-bottom: 0.6rem;
		text-decoration: none;
		background: var(--sl-color-black);
		transition: border-color 0.12s, background 0.12s;
	}
	.ts-sa-source:hover {
		border-color: var(--ts-ac);
		background: var(--sl-color-gray-6);
	}
	.ts-sa-source:hover .ts-sa-source-title {
		color: var(--ts-ac);
	}
	.ts-sa-source-crumb {
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
		margin-bottom: 0.25rem;
	}
	.ts-sa-source-crumb .ts-sa-sep {
		margin-inline: 0.3rem;
		opacity: 0.7;
	}
	.ts-sa-source-title {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		color: var(--sl-color-white);
	}
	.ts-sa-source-title svg {
		color: var(--sl-color-gray-3);
		flex-shrink: 0;
	}

	/* ---- foot: starter chips, then the composer ----
	   The AI wash rises behind both and fades out upward, so the bottom of the
	   panel reads as one surface instead of a bordered box on white. */
	.ts-sa-foot {
		position: relative;
		flex-shrink: 0;
		padding-top: 1rem;
	}
	.ts-sa-foot::before {
		content: '';
		position: absolute;
		inset: -2.5rem -16px -12px;
		background: var(--ts-ai-wash);
		mask-image: linear-gradient(to bottom, transparent, #000 55%);
		pointer-events: none;
	}
	.ts-sa-foot > * {
		position: relative;
	}

	/* Starter chips: full-width pills, stacked, reading order top to bottom so
	   the one nearest the composer is the one the cursor is already near. */
	.ts-sa-chips {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 6px;
		margin-bottom: 10px;
	}
	.ts-sa-chip {
		max-width: 100%;
		padding: 8px 14px;
		border: none;
		border-radius: 999px;
		background: var(--ts-panel);
		color: var(--ts-tx2);
		font: inherit;
		font-size: 13px;
		text-align: start;
		cursor: pointer;
		transition:
			background var(--ts-t) var(--ts-ease),
			color var(--ts-t) var(--ts-ease);
	}
	.ts-sa-chip:hover {
		background: var(--ts-hover);
		color: var(--ts-tx);
	}

	.ts-sa-form {
		border: 1px solid var(--ts-bd);
		border-radius: 14px;
		padding: 4px 6px 6px;
		background: var(--ts-bg);
		transition: border-color var(--ts-t) var(--ts-ease);
	}
	.ts-sa-form:focus-within {
		border-color: var(--ts-ai-bd);
	}
	.ts-sa-input {
		display: block;
		width: 100%;
		border: none;
		outline: none;
		background: transparent;
		color: var(--ts-tx);
		font: inherit;
		font-size: 13.5px;
		padding: 8px 8px 4px;
	}
	.ts-sa-input::placeholder {
		color: var(--ts-tx3);
	}
	/* Second row inside the composer: what the answers are drawn from, and the
	   Send button (which becomes Stop mid-stream -- one control, one place). */
	.ts-sa-form-foot {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 8px;
		padding: 0 2px 0 8px;
	}
	.ts-sa-ctx {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		min-width: 0;
		font-size: 11.5px;
		color: var(--ts-tx3);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.ts-sa-ai-badge {
		flex: none;
		padding: 1px 5px;
		border-radius: 4px;
		background: var(--ts-ac-soft);
		color: var(--ts-tx2);
		font-size: 9.5px;
		font-weight: 700;
		letter-spacing: 0.04em;
	}
	/* Muted until there is something to send; the brand gradient once there is,
	   which is also the only colour in the panel besides the wash. */
	.ts-sa-send {
		flex: none;
		padding: 5px 14px;
		border: none;
		border-radius: 8px;
		background: transparent;
		color: var(--ts-tx3);
		font: inherit;
		font-size: 13px;
		font-weight: 600;
		cursor: pointer;
	}
	.ts-sa-form.ts-sa-hastext .ts-sa-send,
	.ts-sa-form.ts-sa-streaming .ts-sa-send {
		background: var(--ts-ai-grad);
		color: #fff;
	}
	.ts-sa-form.ts-sa-hastext .ts-sa-send:hover,
	.ts-sa-form.ts-sa-streaming .ts-sa-send:hover {
		filter: brightness(1.1);
	}

	/* Shared dialog footer: hints in Search mode, Stop/Clear in Ask mode.
	   Sticky against the scrolling dialog frame (long result lists scroll the
	   frame, and the footer must stay visible), bleeding over the frame's own
	   padding so nothing shows beneath it. */
	.ts-sa-dialogfoot {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		min-height: 1.5rem;
		flex-shrink: 0;
		position: sticky;
		z-index: 1;
		bottom: -1rem;
		margin: auto -1rem -1rem;
		padding: 0.7rem 1rem;
		background: var(--ts-bg);
		border-top: 1px solid var(--ts-bd);
	}
	@media (min-width: 50rem) {
		.ts-sa-dialogfoot {
			bottom: -1.5rem;
			margin: auto -1.5rem -1.5rem;
			padding: 0.7rem 1.5rem;
		}
	}
	.ts-sa-hints {
		display: inline-flex;
		align-items: center;
		gap: 0.9rem;
		font-size: 11.5px;
		color: var(--ts-tx3);
	}
	.ts-sa-hints[hidden] {
		display: none;
	}
	.ts-sa-hints kbd {
		font-family: var(--__sl-font);
		font-size: 10.5px;
		border: 1px solid var(--ts-bd);
		border-radius: 0.25rem;
		padding: 0 0.3rem;
		margin-inline-end: 2px;
		background: transparent;
	}
	/* Inline stream error + retry (never a blank thread) */
	.ts-sa-error {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		color: var(--ts-dang);
		font-size: var(--sl-text-sm);
	}
	.ts-sa-retry {
		border: 1px solid var(--ts-dang-bd);
		border-radius: 0.4rem;
		background: var(--ts-dang-bg);
		color: var(--ts-dang);
		font: inherit;
		font-size: var(--sl-text-xs);
		font-weight: 600;
		padding: 0.15rem 0.7rem;
		cursor: pointer;
	}
	.ts-sa-retry:hover {
		border-color: var(--ts-dang);
	}

	/* API-unavailable fallback */
	.ts-sa-fallback {
		display: block;
		margin-top: 0.5rem;
		border: 1px dashed var(--ts-bd);
		border-radius: 0.5rem;
		background: transparent;
		color: var(--ts-tx2);
		font: inherit;
		font-size: var(--sl-text-sm);
		padding: 0.5rem 0.9rem;
		cursor: pointer;
	}
	.ts-sa-fallback:hover {
		border-color: var(--ts-tx3);
		color: var(--ts-tx);
	}

	/* ── Markdown answer styles ──
	   Moved here from the deleted AskOverlay drawer: renderMarkdown() in
	   ask-shared.ts emits `ts-ask-*` classes, and the search modal thread is now
	   the only place they render. Scoped under .ts-sa-thread. Inline code chips
	   and [N] citation superscripts carry the AI treatment. */
	.ts-sa-thread .ts-ask-answer p {
		margin: 0 0 0.9em;
	}
	.ts-sa-thread .ts-ask-answer p:last-child {
		margin-bottom: 0;
	}
	.ts-sa-thread .ts-ask-answer :first-child {
		margin-top: 0;
	}
	.ts-sa-thread .ts-ask-answer :is(h1, h2, h3, h4, h5, h6) {
		font-weight: 700;
		line-height: 1.3;
		letter-spacing: -0.01em;
		color: var(--ts-tx);
		margin: 1.15em 0 0.5em;
	}
	.ts-sa-thread .ts-ask-answer h1 { font-size: 16px; }
	.ts-sa-thread .ts-ask-answer h2 { font-size: 15px; }
	.ts-sa-thread .ts-ask-answer :is(h3, h4, h5, h6) { font-size: 14px; }
	.ts-sa-thread .ts-ask-answer :is(ul, ol) {
		margin: 0 0 0.9em;
		padding-left: 1.45em;
	}
	.ts-sa-thread .ts-ask-answer li { margin: 0.3em 0; }
	.ts-sa-thread .ts-ask-answer li::marker { color: var(--ts-tx3); }
	.ts-sa-thread .ts-ask-answer a {
		color: var(--ts-ac);
		text-decoration: underline;
		text-underline-offset: 2px;
	}
	.ts-sa-thread .ts-ask-answer a:hover { text-decoration: none; }
	.ts-sa-thread .ts-ask-answer blockquote {
		margin: 0 0 0.9em;
		padding: 6px 0 6px 12px;
		border-left: 3px solid var(--ts-bd);
		color: var(--ts-tx2);
	}
	.ts-sa-thread .ts-ask-answer hr {
		border: none;
		border-top: 1px solid var(--ts-bd);
		margin: 1.1em 0;
	}

	/* Inline code chips + [N] citations: the AI treatment. The greeting's
	   product chip gets the same look. */
	.ts-sa-thread .ts-ask-answer code,
	.ts-sa-msg-body > p > code {
		font-size: 12px;
		font-family: var(--sl-font-mono);
		background: var(--ts-ai-wash);
		border: 1px solid var(--ts-ai-bd);
		color: var(--ts-ai);
		padding: 1px 6px;
		border-radius: 5px;
		overflow-wrap: anywhere;
	}
	.ts-sa-thread .ts-ask-cite {
		font-size: 10px;
		font-weight: 700;
		vertical-align: super;
		line-height: 1;
		background: var(--ts-ai-wash);
		border: 1px solid var(--ts-ai-bd);
		color: var(--ts-ai);
		border-radius: 4px;
		padding: 0 3px;
		margin-inline-start: 1px;
	}

	/* Inline endpoint/URL chips — click to copy */
	.ts-sa-thread .ts-ask-answer code.ts-ask-inline-copy {
		display: inline-flex;
		align-items: center;
		gap: 5px;
		cursor: pointer;
		padding-right: 5px;
		transition: border-color 0.12s;
	}
	.ts-sa-thread .ts-ask-answer code.ts-ask-inline-copy .ts-ask-ic-txt {
		overflow-wrap: anywhere;
	}
	.ts-sa-thread .ts-ask-answer code.ts-ask-inline-copy .ts-ask-ic-btn {
		display: inline-flex;
		align-items: center;
		opacity: 0.55;
		transition: opacity 0.12s;
	}
	.ts-sa-thread .ts-ask-answer code.ts-ask-inline-copy:hover {
		border-color: var(--ts-ai);
	}
	.ts-sa-thread .ts-ask-answer code.ts-ask-inline-copy:hover .ts-ask-ic-btn {
		opacity: 1;
	}
	.ts-sa-thread .ts-ask-answer code.ts-ask-inline-copy:focus-visible {
		outline: 2px solid var(--ts-ai);
		outline-offset: 1px;
	}
	.ts-sa-thread .ts-ask-answer code.ts-ask-inline-copy.is-copied {
		border-color: var(--ts-tip);
		color: var(--ts-tip);
	}
	.ts-sa-thread .ts-ask-answer code.ts-ask-inline-copy.is-copied .ts-ask-ic-btn {
		opacity: 1;
	}

	/* Tables (GFM) */
	.ts-sa-thread .ts-ask-tablewrap {
		margin: 0 0 1em;
		overflow-x: auto;
		border: 1px solid var(--ts-bd);
		border-radius: 9px;
	}
	.ts-sa-thread .ts-ask-table {
		border-collapse: collapse;
		width: 100%;
		font-size: 13px;
	}
	.ts-sa-thread .ts-ask-table :is(th, td) {
		text-align: left;
		padding: 9px 14px;
		vertical-align: top;
		border-bottom: 1px solid var(--ts-bd);
	}
	.ts-sa-thread .ts-ask-table thead th {
		font-weight: 700;
		color: var(--ts-tx);
		background: var(--ts-panel);
		white-space: nowrap;
	}
	.ts-sa-thread .ts-ask-table td { color: var(--ts-tx2); }
	.ts-sa-thread .ts-ask-table tbody tr:last-child td { border-bottom: none; }

	/* Code block — header (language + copy) over the snippet */
	.ts-sa-thread .ts-ask-codeblock {
		margin: 0 0 1em;
		border: 1px solid var(--ts-bd);
		border-radius: 9px;
		overflow: hidden;
		background: var(--ts-code-bg);
	}
	.ts-sa-thread .ts-ask-code-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 6px 8px 6px 12px;
		background: var(--ts-panel);
