	/* Thinking indicator */
	.ts-sa-think {
		display: flex;
		align-items: center;
		gap: 2px;
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
	}
	.ts-sa-think[hidden] {
		display: none;
