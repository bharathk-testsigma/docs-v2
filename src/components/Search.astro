---
/**
 * Fork of Starlight's Search.astro (@astrojs/starlight 0.41) with exactly one
 * change: the two `import.meta.env.DEV` gates are removed, so the Pagefind
 * dialog also works under `astro dev`. Stock Starlight refuses to search in
 * dev ("Search is only available in production builds"), but this repo's
 * `postbuild` copies the Pagefind index into public/ precisely so dev search
 * works — see the "//search" note in package.json. Before the first build the
 * dialog simply finds no index and shows no results; run `npm run build` once.
 *
 * On Starlight upgrades, if this breaks: re-copy
 * node_modules/@astrojs/starlight/components/Search.astro over this file,
 * re-point the Icon import at { Icon } from '@astrojs/starlight/components',
 * and delete the two DEV gates again.
 */
import { Icon } from '@astrojs/starlight/components';
import project from 'virtual:starlight/project-context';

const pagefindTranslations = {
	placeholder: Astro.locals.t('search.label'),
	...Object.fromEntries(
		Object.entries(Astro.locals.t.all())
			.filter(([key]) => key.startsWith('pagefind.'))
			.map(([key, value]) => [key.replace('pagefind.', ''), value])
	),
};

const dataAttributes: DOMStringMap = { 'data-translations': JSON.stringify(pagefindTranslations) };
if (project.trailingSlash === 'never') dataAttributes['data-strip-trailing-slash'] = '';
---

<site-search class={Astro.props.class} {...dataAttributes}>
	<button
		data-open-modal
		disabled
		aria-label={Astro.locals.t('search.label')}
		aria-keyshortcuts="Control+K"
	>
		<Icon name="magnifier" />
		<span class="sl-hidden md:sl-block" aria-hidden="true">{Astro.locals.t('search.label')}</span>
		<kbd class="sl-hidden md:sl-flex" style="display: none;">
			<kbd>{Astro.locals.t('search.ctrlKey')}</kbd><kbd>K</kbd>
		</kbd>
	</button>

	<dialog style="padding:0" aria-label={Astro.locals.t('search.label')}>
		<div class="dialog-frame sl-flex">
			{
				/* TODO: Make the layout of this button flexible to accommodate different word lengths. Currently hard-coded for English: “Cancel” */
			}
			<button data-close-modal class="sl-flex md:sl-hidden">
				{Astro.locals.t('search.cancelLabel')}
			</button>
			<div class="ts-sa-toggle" role="tablist" aria-label="Search mode">
				<button type="button" class="ts-sa-tab" data-sa-mode="search" role="tab" aria-selected="true">
					<Icon name="magnifier" size="0.85rem" />
					Search
				</button>
				<button type="button" class="ts-sa-tab" data-sa-mode="ask" role="tab" aria-selected="false">
					<svg class="ts-sa-spark" width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l2.2 6.6L21 11l-6.8 2.4L12 20l-2.2-6.6L3 11l6.8-2.4z"/></svg>
					Ask Assistant
				</button>
			</div>
			<div class="search-container">
				<div id="starlight__search" />
			</div>
			{/* Empty state: shown in Search mode while no query is typed. */}
			<div class="ts-sa-empty" id="ts-sa-empty">
				<div class="ts-sa-eyebrow">Popular questions</div>
				<div id="ts-sa-sugs"></div>
			</div>
			{/* Moved into Pagefind's form once it renders — sits between input and results. */}
			<button type="button" class="ts-sa-row" id="ts-sa-row" hidden>
				<svg class="ts-sa-spark ts-sa-row-spark" width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l2.2 6.6L21 11l-6.8 2.4L12 20l-2.2-6.6L3 11l6.8-2.4z"/></svg>
				<span class="ts-sa-row-label">Ask Assistant</span>
				<span class="ts-sa-row-q" id="ts-sa-row-q"></span>
				<span class="ts-sa-row-cta">Start conversation <kbd>↵</kbd></span>
			</button>
			<div class="ts-sa-view" id="ts-sa-view" hidden>
				<div class="ts-sa-label">Ask Assistant</div>
				<div class="ts-sa-thread" id="ts-sa-thread">
					<div class="ts-sa-msg" id="ts-sa-greeting">
						<span class="ts-sa-avatar ts-sa-spark" aria-hidden="true">
							<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.2 6.6L21 11l-6.8 2.4L12 20l-2.2-6.6L3 11l6.8-2.4z"/></svg>
						</span>
						<div class="ts-sa-msg-body">
							<p><strong>Hey.</strong></p>
							<p>Ask anything.</p>
							<p>I'll find the answer across Testsigma's product knowledge.</p>
						</div>
					</div>
				</div>
				<div class="ts-sa-foot">
					<form class="ts-sa-form" id="ts-sa-form">
						<input
							class="ts-sa-input"
							id="ts-sa-input"
							placeholder="How do I get started?"
							autocomplete="off"
						/>
						<button type="submit" class="ts-sa-send" aria-label="Send">
							<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 2 11 13M22 2l-7 20-4-9-9-4z"/></svg>
						</button>
					</form>
				</div>
			</div>
			<div class="ts-sa-dialogfoot">
				<span class="ts-sa-hints" id="ts-sa-hints">
					<span><kbd>↑</kbd><kbd>↓</kbd> to navigate</span>
					<span><kbd>↵</kbd> to select</span>
					<span><kbd>esc</kbd> to close</span>
				</span>
				<button type="button" class="ts-sa-clear" id="ts-sa-clear" hidden>Clear</button>
			</div>
		</div>
	</dialog>
</site-search>

{
	/**
	 * This is intentionally inlined to avoid briefly showing an invalid shortcut.
	 * Purposely using the deprecated `navigator.platform` property to detect Apple devices, as the
	 * user agent is spoofed by some browsers when opening the devtools.
	 */
}
<script is:inline>
	(() => {
		const openBtn = document.querySelector('button[data-open-modal]');
		const shortcut = openBtn?.querySelector('kbd');
		if (!openBtn || !(shortcut instanceof HTMLElement)) return;
		const platformKey = shortcut.querySelector('kbd');
		if (platformKey && /(Mac|iPhone|iPod|iPad)/i.test(navigator.platform)) {
			platformKey.textContent = '⌘';
			openBtn.setAttribute('aria-keyshortcuts', 'Meta+K');
		}
		shortcut.style.display = '';
	})();
</script>

<script>
	import { pagefindUserConfig } from 'virtual:starlight/pagefind-config';
	import { streamAsk, sendFeedback, renderMarkdown, escapeHtml, bindCopyHandlers, product, IC_COPY, IC_CHECK } from '../scripts/ask-shared';
	// Retrieval-index URLs are stored base-free ('/suite/...'), so each source
	// link needs prefixing before it goes into the DOM or it 404s under the base.
	import { withBase } from '../lib/base';

	// Suggested questions for the empty state, per product (first 4 are shown).
	const SUGGESTIONS: Record<string, string[]> = {
		suite: [
			'How do I create a test case?',
			'What is Auto-Healing and how does it work?',
			'How do I trigger a Test Plan via API?',
			'How do I set up test data profiles?',
		],
		arcus: [
			'How do I create a test case?',
			'How do I create a test run?',
			'How do I invite users and assign roles?',
			'How do I set up custom fields?',
		],
	};

	class SiteSearch extends HTMLElement {
		constructor() {
			super();
			const openBtn = this.querySelector<HTMLButtonElement>('button[data-open-modal]')!;
			const closeBtn = this.querySelector<HTMLButtonElement>('button[data-close-modal]')!;
			const dialog = this.querySelector('dialog')!;
			const dialogFrame = this.querySelector('.dialog-frame')!;

			// ── Ask Assistant mode ─────────────────────────────────────────────
			const searchContainer = this.querySelector<HTMLElement>('.search-container')!;
			const askRow = this.querySelector<HTMLButtonElement>('#ts-sa-row')!;
			const askRowQ = this.querySelector<HTMLElement>('#ts-sa-row-q')!;
			const askView = this.querySelector<HTMLElement>('#ts-sa-view')!;
			const askThread = this.querySelector<HTMLElement>('#ts-sa-thread')!;
			const askForm = this.querySelector<HTMLFormElement>('#ts-sa-form')!;
			const askInput = this.querySelector<HTMLInputElement>('#ts-sa-input')!;
			const emptyState = this.querySelector<HTMLElement>('#ts-sa-empty')!;
			const sugsWrap = this.querySelector<HTMLElement>('#ts-sa-sugs')!;
			const hintsEl = this.querySelector<HTMLElement>('#ts-sa-hints')!;
			const footBtn = this.querySelector<HTMLButtonElement>('#ts-sa-clear')!;
			const tabs = [...this.querySelectorAll<HTMLButtonElement>('.ts-sa-tab')];

			// In-flight stream state: the footer button is Stop while streaming,
			// Clear otherwise.
			let controller: AbortController | null = null;
			let streaming = false;
			const setFootBtn = () => {
				footBtn.textContent = streaming ? 'Stop' : 'Clear';
			};

			const pfQuery = () =>
				this.querySelector<HTMLInputElement>('.pagefind-ui__search-input')?.value.trim() ?? '';
			const syncEmptyState = () => {
				emptyState.hidden = !(searchContainer.hidden === false && !pfQuery());
			};

			let mode: 'search' | 'ask' = 'search';
			const setMode = (m: 'search' | 'ask') => {
				mode = m;
				searchContainer.hidden = m === 'ask';
				askView.hidden = m !== 'ask';
				hintsEl.hidden = m !== 'search';
				footBtn.hidden = m !== 'ask';
				syncEmptyState();
				for (const t of tabs) t.setAttribute('aria-selected', String(t.dataset.saMode === m));
				setTimeout(() => {
					(m === 'ask' ? askInput : this.querySelector<HTMLInputElement>('.pagefind-ui__search-input'))?.focus();
				}, 0);
			};
			for (const t of tabs)
				t.addEventListener('click', () => {
					if (t.dataset.saMode === 'ask' && mode !== 'ask') {
						const q = pfQuery();
						if (q) askInput.value = q;
					}
					setMode(t.dataset.saMode as 'search' | 'ask');
				});

			const startAsk = (q: string) => {
				setMode('ask');
				if (q) ask(q);
			};

			// Empty-state suggestion rows: click switches to Ask Assistant and
			// submits the question immediately.
			const SPARK_SM =
				'<svg class="ts-sa-spark" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l2.2 6.6L21 11l-6.8 2.4L12 20l-2.2-6.6L3 11l6.8-2.4z"/></svg>';
			for (const q of (SUGGESTIONS[product()] ?? SUGGESTIONS.suite).slice(0, 4)) {
				const b = document.createElement('button');
				b.type = 'button';
				b.className = 'ts-sa-sug';
				b.innerHTML = `${SPARK_SM}<span></span>`;
				b.querySelector('span')!.textContent = q;
				b.addEventListener('click', () => startAsk(q));
				sugsWrap.appendChild(b);
			}

			const syncSend = () => askForm.classList.toggle('ts-sa-hastext', !!askInput.value.trim());
			askInput.addEventListener('input', syncSend);

			askForm.addEventListener('submit', (e) => {
				e.preventDefault();
				const q = askInput.value.trim();
				if (!q) return;
				askInput.value = '';
				syncSend();
				ask(q);
			});

			bindCopyHandlers(askThread);

			footBtn.addEventListener('click', () => {
				if (streaming && controller) {
					// Stop: abort mid-stream, keep the partial answer.
					controller.abort();
					return;
				}
				// Clear: reset the thread to the greeting, and forget the history.
				for (const m of askThread.querySelectorAll('.ts-sa-msg:not(#ts-sa-greeting)')) m.remove();
				turns = [];
				askInput.placeholder = 'How do I get started?';
				askInput.focus();
			});

			const SPARK =
				'<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l2.2 6.6L21 11l-6.8 2.4L12 20l-2.2-6.6L3 11l6.8-2.4z"/></svg>';
			const USER =
				'<svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9.2"/><circle cx="12" cy="10" r="3"/><path d="M6.2 19a6.5 6.5 0 0 1 11.6 0"/></svg>';
			const BOOK =
				'<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 4h6a4 4 0 0 1 4 4v12a3 3 0 0 0-3-3H2zM22 4h-6a4 4 0 0 0-4 4v12a3 3 0 0 1 3-3h7z"/></svg>';

			// "Docs › Suite › Web" style breadcrumb from a docs URL.
			const crumbs = (url: string) => {
				const cap = (s: string) => s.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
				return ['Docs', ...url.split('/').filter(Boolean).slice(0, -1).map(cap)]
					.slice(0, 3)
					.join(' <span class="ts-sa-sep">›</span> ');
			};

			// Conversation so far, sent with each question so follow-ups resolve.
			// Reset by Clear (below), same as the visible thread.
			let turns: { role: 'user' | 'assistant'; content: string }[] = [];

			async function ask(query: string) {
				const priorTurns = [...turns];
				// Retrieved sources for THIS answer, attached to any vote on it.
				let lastSources: { url: string; title: string }[] = [];
				const userMsg = document.createElement('div');
				userMsg.className = 'ts-sa-msg';
				userMsg.innerHTML = `
					<span class="ts-sa-avatar" aria-hidden="true">${USER}</span>
					<div class="ts-sa-msg-body ts-sa-q">${escapeHtml(query)}</div>
				`;
				const aiMsg = document.createElement('div');
				aiMsg.className = 'ts-sa-msg';
				aiMsg.innerHTML = `
					<span class="ts-sa-avatar ts-sa-spark" aria-hidden="true">${SPARK}</span>
					<div class="ts-sa-msg-body">
						<div class="ts-sa-think">
							<span data-sa-status>Thinking</span>
							<span class="ts-sa-dots"><i></i><i></i><i></i></span>
						</div>
						<div class="ts-ask-answer"></div>
						<div class="ts-sa-actions" hidden>
							<button type="button" class="ts-sa-act" data-sa-copy title="Copy answer">${IC_COPY}</button>
							<button type="button" class="ts-sa-act" data-sa-vote="up" title="Good answer" aria-pressed="false">
								<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 10v12M15 5.88 14 10h5.83a2 2 0 0 1 1.92 2.56l-2.33 8A2 2 0 0 1 17.5 22H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2.76a2 2 0 0 0 1.79-1.11L12 2a3.13 3.13 0 0 1 3 3.88Z"/></svg>
							</button>
							<button type="button" class="ts-sa-act" data-sa-vote="down" title="Bad answer" aria-pressed="false">
								<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 14V2M9 18.12 10 14H4.17a2 2 0 0 1-1.92-2.56l2.33-8A2 2 0 0 1 6.5 2H20a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-2.76a2 2 0 0 0-1.79 1.11L12 22a3.13 3.13 0 0 1-3-3.88Z"/></svg>
							</button>
						</div>
						<div class="ts-sa-sources" hidden></div>
					</div>
				`;
				askThread.append(userMsg, aiMsg);
				const thinkingEl = aiMsg.querySelector<HTMLElement>('.ts-sa-think')!;
				const statusEl = aiMsg.querySelector<HTMLElement>('[data-sa-status]')!;
				const answerEl = aiMsg.querySelector<HTMLElement>('.ts-ask-answer')!;
				const actionsEl = aiMsg.querySelector<HTMLElement>('.ts-sa-actions')!;
				const sourcesEl = aiMsg.querySelector<HTMLElement>('.ts-sa-sources')!;

				const copyBtn = aiMsg.querySelector<HTMLButtonElement>('[data-sa-copy]')!;
				copyBtn.addEventListener('click', () => {
					navigator.clipboard?.writeText(answerEl.innerText);
					copyBtn.innerHTML = IC_CHECK;
					setTimeout(() => { copyBtn.innerHTML = IC_COPY; }, 1300);
				});

				// Votes POST to /api/ask-feedback with the retrieved sources, so a
				// thumbs-down is diagnosable later. Fire-and-forget: a failed log
				// must never surface to the reader.
				const votes = aiMsg.querySelectorAll<HTMLButtonElement>('[data-sa-vote]');
				for (const v of votes)
					v.addEventListener('click', () => {
						for (const o of votes) o.setAttribute('aria-pressed', String(o === v));
						sendFeedback({
							question: query,
							vote: v.dataset.saVote === 'down' ? 'down' : 'up',
							sources: lastSources,
							answerPreview: answerEl.innerText.slice(0, 400),
						});
					});

				// Follow the stream, but stop auto-scrolling if the reader scrolls up.
				const scroll = () => {
					const stick = askThread.scrollHeight - askThread.scrollTop - askThread.clientHeight < 90;
					if (stick) askThread.scrollTop = askThread.scrollHeight;
				};
				askThread.scrollTop = askThread.scrollHeight;

				controller = new AbortController();
				streaming = true;
				setFootBtn();
				let answerMd = '';
				try {
					await streamAsk(query, {
						status: (text) => { statusEl.textContent = text.replace(/…$/, ''); },
						delta: (md) => {
							thinkingEl.hidden = true;
							answerMd = md;
							answerEl.innerHTML = renderMarkdown(md);
							scroll();
						},
						sources: (srcs) => {
							lastSources = srcs;
							if (!srcs.length) return;
							sourcesEl.innerHTML =
								'<div class="ts-sa-sources-head">Sources</div>' +
								srcs.map(s =>
									`<a class="ts-sa-source" href="${escapeHtml(withBase(s.url))}">
										<div class="ts-sa-source-crumb">${crumbs(s.url)}</div>
										<div class="ts-sa-source-title">${BOOK}<span>${escapeHtml(s.title || s.url)}</span></div>
									</a>`
								).join('');
							sourcesEl.hidden = false;
							scroll();
						},
					}, controller.signal, priorTurns);
					thinkingEl.hidden = true;
					actionsEl.hidden = false;
					// Record the completed exchange for the next follow-up.
					if (answerMd) turns = [...priorTurns, { role: 'user', content: query }, { role: 'assistant', content: answerMd }];
					askInput.placeholder = 'Ask a follow-up question…';
					askInput.focus();
				} catch {
					thinkingEl.hidden = true;
					if (controller.signal.aborted) {
						// Stopped by the reader: keep the partial answer as-is.
						if (answerEl.innerHTML) actionsEl.hidden = false;
					} else {
						// Inline error line + retry, plus the keyword-search fallback.
						const err = document.createElement('div');
						err.className = 'ts-sa-error';
						err.textContent = 'The assistant is unavailable right now.';
						const retry = document.createElement('button');
						retry.type = 'button';
						retry.className = 'ts-sa-retry';
						retry.textContent = 'Retry';
						retry.addEventListener('click', () => {
							userMsg.remove();
							aiMsg.remove();
							ask(query);
						});
						err.appendChild(retry);
						const back = document.createElement('button');
						back.type = 'button';
						back.className = 'ts-sa-fallback';
						back.textContent = 'Search the docs instead';
						back.addEventListener('click', () => {
							setMode('search');
							const pfInput = document.querySelector<HTMLInputElement>('.pagefind-ui__search-input');
							if (pfInput) {
								pfInput.value = query;
								pfInput.dispatchEvent(new Event('input', { bubbles: true }));
							}
						});
						answerEl.append(err, back);
					}
				} finally {
					streaming = false;
					controller = null;
					setFootBtn();
				}
			}

			/** Close the modal if a user clicks on a link or outside of the modal. */
			const onClick = (event: MouseEvent) => {
				const isLink = 'href' in (event.target || {});
				if (
					isLink ||
					(document.body.contains(event.target as Node) &&
						!dialogFrame.contains(event.target as Node))
				) {
					closeModal();
				}
			};

			// Always opens in Search mode, regardless of the last used tab; the
			// Ask button in the header opens straight into Ask Assistant.
			let lastTrigger: HTMLElement | null = null;
			const openModal = (event?: MouseEvent, m: 'search' | 'ask' = 'search') => {
				lastTrigger = document.activeElement as HTMLElement;
				dialog.showModal();
				document.body.toggleAttribute('data-search-modal-open', true);
				setMode(m);
				event?.stopPropagation();
				window.addEventListener('click', onClick);
			};

			const closeModal = () => dialog.close();

			openBtn.addEventListener('click', (e) => openModal(e, 'search'));
			openBtn.disabled = false;
			closeBtn.addEventListener('click', closeModal);

			dialog.addEventListener('close', () => {
				document.body.toggleAttribute('data-search-modal-open', false);
				window.removeEventListener('click', onClick);
				lastTrigger?.focus?.();
				lastTrigger = null;
			});

			// Listen for `ctrl + k` and `cmd + k` keyboard shortcuts.
			window.addEventListener('keydown', (e) => {
				if ((e.metaKey === true || e.ctrlKey === true) && e.key === 'k') {
					dialog.open ? closeModal() : openModal();
					e.preventDefault();
				}
			});

			let translations = {};
			try {
				translations = JSON.parse(this.dataset.translations || '{}');
			} catch {}

			const shouldStrip = this.dataset.stripTrailingSlash !== undefined;
			const stripTrailingSlash = (path: string) => path.replace(/(.)\/(#.*)?$/, '$1$2');
			const formatURL = shouldStrip ? stripTrailingSlash : (path: string) => path;

			window.addEventListener('DOMContentLoaded', () => {
				const onIdle = window.requestIdleCallback || ((cb) => setTimeout(cb, 1));
				onIdle(async () => {
					// @ts-expect-error — Missing types for @pagefind/default-ui package.
					const { PagefindUI } = await import('@pagefind/default-ui');
					new PagefindUI({
						...pagefindUserConfig,
						element: '#starlight__search',
						baseUrl: import.meta.env.BASE_URL,
						bundlePath: import.meta.env.BASE_URL.replace(/\/$/, '') + '/pagefind/',
						showImages: false,
						translations,
						showSubResults: true,
						processResult: (result: { url: string; sub_results: Array<{ url: string }> }) => {
							result.url = formatURL(result.url);
							result.sub_results = result.sub_results.map((sub_result) => {
								sub_result.url = formatURL(sub_result.url);
								return sub_result;
							});
						},
					});

					// Slot the "Ask Assistant" row between Pagefind's input and its
					// results, mirror the query into it, and make Enter start a
					// conversation. A chip row (All/Docs counts) sits above the cards.
					const pfForm = this.querySelector('.pagefind-ui__form');
					const pfDrawer = pfForm?.querySelector('.pagefind-ui__drawer') ?? null;
					const pfInput = this.querySelector<HTMLInputElement>('.pagefind-ui__search-input');

					// Product chips: All / Suite / Arcus. They drive Pagefind UI's own
					// (visually hidden) filter checkboxes, fed by each page's
					// data-pagefind-filter="product" meta — so both the filtering and
					// the counts are Pagefind's real numbers.
					const chipRow = document.createElement('div');
					chipRow.className = 'ts-sa-chiprow';
					chipRow.hidden = true;
					chipRow.setAttribute('role', 'group');
					chipRow.setAttribute('aria-label', 'Filter results by product');
					chipRow.innerHTML =
						'<button type="button" class="ts-sa-chip" data-product="" aria-pressed="true">All</button>' +
						'<button type="button" class="ts-sa-chip" data-product="Suite" aria-pressed="false">Suite</button>' +
						'<button type="button" class="ts-sa-chip" data-product="Arcus" aria-pressed="false">Arcus</button>';
					const chips = [...chipRow.querySelectorAll<HTMLButtonElement>('.ts-sa-chip')];

					// Pagefind renders one checkbox per filter value once results exist.
					const filterCheckbox = (value: string) =>
						[...this.querySelectorAll<HTMLInputElement>('.pagefind-ui__form input[type="checkbox"]')].find(
							(c) => (c.value || c.id || '').includes(value)
						);

					const applyProduct = (product: string) => {
						for (const value of ['Suite', 'Arcus']) {
							const box = filterCheckbox(value);
							if (box && box.checked !== (value === product)) box.click();
						}
						for (const c of chips)
							c.setAttribute('aria-pressed', String((c.dataset.product || '') === product));
					};
					chipRow.addEventListener('click', (e) => {
						const chip = (e.target as HTMLElement).closest<HTMLButtonElement>('.ts-sa-chip');
						if (chip) applyProduct(chip.dataset.product || '');
					});

					if (pfForm) {
						pfForm.insertBefore(askRow, pfDrawer);
						pfForm.insertBefore(chipRow, pfDrawer);
					}

					const syncSearchUi = () => {
						const q = pfQuery();
						askRow.hidden = !q;
						if (!q) chipRow.hidden = true;
						syncEmptyState();
					};

					pfInput?.addEventListener('input', () => {
						askRowQ.textContent = pfInput.value.trim();
						syncSearchUi();
					});
					syncSearchUi();

					pfInput?.addEventListener('keydown', (e) => {
						if (e.key === 'Enter') {
							e.preventDefault();
							startAsk(pfInput.value.trim());
						}
					});
					askRow.addEventListener('click', () => {
						startAsk(pfQuery());
					});

					// Decorate Pagefind's results into cards: breadcrumb line per
					// result, <mark> → <strong> in excerpts, and result counts in the
					// chip row (read off Pagefind's own "N results" message).
					if (pfDrawer) {
						const decorate = () => {
							for (const inner of pfDrawer.querySelectorAll('.pagefind-ui__result-inner')) {
								if (inner.querySelector('.ts-sa-crumb')) continue;
								const href = inner.querySelector<HTMLAnchorElement>('.pagefind-ui__result-link')?.getAttribute('href') || '';
								const crumb = document.createElement('div');
								crumb.className = 'ts-sa-crumb';
								crumb.innerHTML = crumbs(href);
								inner.prepend(crumb);
							}
							for (const mark of pfDrawer.querySelectorAll('.pagefind-ui__result-excerpt mark')) {
								const strong = document.createElement('strong');
								strong.textContent = mark.textContent;
								mark.replaceWith(strong);
							}
							const msg = pfDrawer.querySelector('.pagefind-ui__message')?.textContent || '';
							const total = msg.match(/\d+/)?.[0];
							if (total !== undefined && pfQuery()) {
								// "All" shows the unfiltered total, so only refresh it while no
								// product filter is active (the message reflects the filter).
								const active =
									chips.find((c) => c.getAttribute('aria-pressed') === 'true')?.dataset.product || '';
								if (active === '') chips[0].textContent = `All (${total})`;
								// Pagefind's filter-value labels carry per-product counts
								// ("Suite (123)") — mirror them onto the chips.
								for (const label of this.querySelectorAll('.pagefind-ui__filter-value')) {
									const text = (label.textContent || '').trim();
									for (const c of chips) {
										if (c.dataset.product && text.startsWith(c.dataset.product)) c.textContent = text;
									}
								}
								chipRow.hidden = false;
							}
						};
						new MutationObserver(decorate).observe(pfDrawer, { childList: true, subtree: true });
						decorate();
					}
				});
			});
		}
	}
	customElements.define('site-search', SiteSearch);
</script>

