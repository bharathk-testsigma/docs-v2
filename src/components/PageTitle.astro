---
/**
 * PageTitle override -- the trail row, then the h1.
 *
 * The V4 shell has no breadcrumbs in the top bar (that bar carries the product
 * switcher, search and the section tabs), so the trail sits back where the
 * canvas puts it: directly above the page title, sharing a row with the page
 * actions.
 */
import CopyPage from './CopyPage.astro';
import Breadcrumbs from './Breadcrumbs.astro';

const { entry } = Astro.locals.starlightRoute;

// API reference pages render their own title (and the `#_top` anchor) inside
// ApiMarkdownContent.astro, so that it sits in the left spec column rather
// than spanning both columns. Splash pages likewise render their own hero
// title, and "Copy page" makes no sense on a feed -- as on the changelog,
// which is a regular doc page (it needs the rail) whose feed owns the h1.
const isApiPage = !!entry.data.api;
const isSplash = entry.data.template === 'splash' || entry.id === 'suite/changelog';
---

{
	!isApiPage && !isSplash && (
		<Fragment>
			<div class="ts-crumb-row">
				<Breadcrumbs />
				<CopyPage />
			</div>
			<h1 id="_top">{entry.data.title}</h1>
		</Fragment>
	)
}

<script>
	// Deep-linkable tabs: clicking a tab stamps a readable hash (#tab-docker),
	// and arriving with one selects that tab and scrolls it into view.
	// Starlight's own component does the switching; this only syncs the URL.
	const slug = (s: string) =>
		s
			.toLowerCase()
			.trim()
			.replace(/[^a-z0-9]+/g, '-');
	const tabs = Array.from(document.querySelectorAll<HTMLAnchorElement>('starlight-tabs [role="tab"]'));
	tabs.forEach((tab) => {
		tab.addEventListener('click', () => {
			history.replaceState(null, '', '#tab-' + slug(tab.textContent ?? ''));
		});
	});
	const m = window.location.hash.match(/^#tab-(.+)/);
	if (m) {
		const target = tabs.find((t) => slug(t.textContent ?? '') === m[1]);
		if (target) {
			// Starlight's <starlight-tabs> attaches the switching handler when the
			// custom element upgrades; clicking before that just jumps the page.
			customElements.whenDefined('starlight-tabs').then(() => {
				target.click();
				target.closest('starlight-tabs')?.scrollIntoView({ block: 'start' });
			});
		}
	}
</script>

<style>
	.ts-crumb-row {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1.5rem;
		margin-bottom: 1.125rem; /* 18px */
	}
	.ts-crumb-row :global(.ts-copy) {
		flex: none;
	}

	h1 {
		min-width: 0;
		font-size: 2.75rem; /* 44px */
		font-weight: 700;
		letter-spacing: -0.03em;
		line-height: 1.12;
		color: var(--ts-tx);
		margin: 0;
		text-wrap: balance;
	}
</style>
