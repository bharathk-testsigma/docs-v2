---
/**
 * ThemeSelect override -- a single click-to-toggle button.
 *
 * Starlight ships a three-option <select> (dark / light / auto). The reference
 * is one button: click flips light <-> dark, no dropdown. Restyling the select
 * to look like a button left it behaving like a select and the icon
 * off-centre inside it, so the control is replaced outright.
 *
 * Starlight's ThemeProvider is NOT overridden, so it still applies the stored
 * theme before first paint (no flash). This component only writes the same
 * `starlight-theme` localStorage key it reads, keeping the two in sync.
 *
 * Trade-off: dropping the select removes the explicit "auto" option. A first
 * visit still follows the OS setting because ThemeProvider falls back to
 * `prefers-color-scheme`; the first click just pins an explicit choice.
 *
 * The icon shown is the theme you will switch TO, which is the convention in
 * the reference (a moon on a light page).
 */
---

<button type="button" class="ts-theme" data-ts-theme aria-live="polite">
	<span class="sr-only" data-ts-theme-label>Switch to dark theme</span>

	{/* Shown on light pages: click for dark. */}
	<svg
		class="ts-theme-icon ts-theme-moon"
		width="15"
		height="15"
		viewBox="0 0 16 16"
		fill="none"
		stroke="currentColor"
		stroke-width="1.3"
		stroke-linecap="round"
		stroke-linejoin="round"
		aria-hidden="true"
	>
		<path d="M13.5 9.6A5.8 5.8 0 0 1 6.4 2.5a5.8 5.8 0 1 0 7.1 7.1Z"></path>
	</svg>

	{/* Shown on dark pages: click for light. */}
	<svg
		class="ts-theme-icon ts-theme-sun"
		width="15"
		height="15"
		viewBox="0 0 16 16"
		fill="none"
		stroke="currentColor"
		stroke-width="1.3"
		stroke-linecap="round"
		stroke-linejoin="round"
		aria-hidden="true"
	>
		<circle cx="8" cy="8" r="3.1"></circle>
		<path d="M8 1.4v1.3M8 13.3v1.3M1.4 8h1.3M13.3 8h1.3M3.4 3.4l.9.9M11.7 11.7l.9.9M12.6 3.4l-.9.9M4.3 11.7l-.9.9"
		></path>
	</svg>
</button>

<style>
	.ts-theme {
		/* Grid centring beats flex here: both icons occupy the same cell, so the
		   glyph is centred whichever one is visible. */
		display: grid;
		place-items: center;
		width: 32px;
		height: 32px;
		padding: 0;
		border: 1px solid var(--ts-bd);
		border-radius: 999px;
		background: var(--ts-bg);
		color: var(--ts-tx2);
		cursor: pointer;
		flex: none;
	}
	.ts-theme:hover {
		background: var(--ts-hover);
		color: var(--ts-tx);
	}
	.ts-theme:focus-visible {
		outline: 2px solid var(--ts-ac);
		outline-offset: 2px;
	}

	.ts-theme-icon {
		grid-area: 1 / 1;
		display: block;
	}

	/* Light theme (Starlight's default is dark, so light is the flagged state):
	   offer the moon. Dark theme: offer the sun. */
	.ts-theme-sun {
		display: block;
	}
	.ts-theme-moon {
		display: none;
	}
	:root[data-theme='light'] .ts-theme-sun {
		display: none;
	}
	:root[data-theme='light'] .ts-theme-moon {
		display: block;
	}
</style>

<script>
	document.querySelectorAll<HTMLButtonElement>('[data-ts-theme]').forEach((btn) => {
		const label = btn.querySelector<HTMLElement>('[data-ts-theme-label]');

		const current = () =>
			document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';

		function syncLabel() {
			if (label) {
				label.textContent =
					current() === 'light' ? 'Switch to dark theme' : 'Switch to light theme';
			}
		}

		syncLabel();

		btn.addEventListener('click', () => {
			const next = current() === 'light' ? 'dark' : 'light';
			document.documentElement.dataset.theme = next;
			try {
				// Same key Starlight's ThemeProvider reads, so the choice survives
				// navigation and is applied before first paint on the next page.
				localStorage.setItem('starlight-theme', next);
			} catch {
				// Private-mode storage failures are non-fatal: the theme still
				// applies for this page, it just will not persist.
			}
			syncLabel();
		});
	});
</script>
