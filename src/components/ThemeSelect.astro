---
/**
 * ThemeSelect override -- a light/dark switcher in the top header.
 *
 * Starlight ships a three-option <select> (dark / light / auto). This is a
 * two-segment pill, rendered inline in the header's utility cluster
 * (Header.astro), immediately before "Book a demo": sun sets light, moon
 * sets dark, and the active segment is filled.
 *
 * Starlight's ThemeProvider is NOT overridden, so it still applies the stored
 * theme before first paint (no flash). This component only writes the same
 * `starlight-theme` localStorage key it reads, keeping the two in sync.
 *
 * Trade-off: no explicit "auto" option. A first visit still follows the OS
 * setting because ThemeProvider falls back to `prefers-color-scheme`; the
 * first click just pins an explicit choice.
 */
---

<div class="ts-theme" role="group" aria-label="Colour theme">
	<button type="button" class="ts-theme-btn ts-theme-light" data-ts-theme-set="light">
		<span class="sr-only">Light theme</span>
		<svg
			width="15"
			height="15"
			viewBox="0 0 16 16"
			fill="none"
			stroke="currentColor"
			stroke-width="1.3"
			stroke-linecap="round"
			stroke-linejoin="round"
			aria-hidden="true"
		>
			<circle cx="8" cy="8" r="3.1"></circle>
			<path d="M8 1.4v1.3M8 13.3v1.3M1.4 8h1.3M13.3 8h1.3M3.4 3.4l.9.9M11.7 11.7l.9.9M12.6 3.4l-.9.9M4.3 11.7l-.9.9"
			></path>
		</svg>
	</button>
	<button type="button" class="ts-theme-btn ts-theme-dark" data-ts-theme-set="dark">
		<span class="sr-only">Dark theme</span>
		<svg
			width="15"
			height="15"
			viewBox="0 0 16 16"
			fill="none"
			stroke="currentColor"
			stroke-width="1.3"
			stroke-linecap="round"
			stroke-linejoin="round"
			aria-hidden="true"
		>
			<path d="M13.5 9.6A5.8 5.8 0 0 1 6.4 2.5a5.8 5.8 0 1 0 7.1 7.1Z"></path>
		</svg>
	</button>
</div>

<style>
	.ts-theme {
		flex: none;
		display: flex;
		gap: 2px;
		padding: 3px;
		border: 1px solid var(--ts-bd);
		border-radius: 999px;
		background: var(--ts-bg);
	}
	.ts-theme-btn {
		display: grid;
		place-items: center;
		width: 28px;
		height: 28px;
		padding: 0;
		border: none;
		border-radius: 999px;
		background: transparent;
		color: var(--ts-tx3);
		cursor: pointer;
	}
	.ts-theme-btn:hover {
		color: var(--ts-tx);
	}
	.ts-theme-btn:focus-visible {
		outline: 2px solid var(--ts-ac);
		outline-offset: 2px;
	}

	/* Active segment: filled. Starlight's default is dark, so dark is active
	   whenever the explicit light flag is absent. */
	:global(:root:not([data-theme='light'])) .ts-theme-dark,
	:global(:root[data-theme='light']) .ts-theme-light {
		background: var(--ts-hover);
		color: var(--ts-tx);
	}
</style>

<script>
	document.querySelectorAll<HTMLButtonElement>('[data-ts-theme-set]').forEach((btn) => {
		btn.addEventListener('click', () => {
			const next = btn.dataset.tsThemeSet === 'light' ? 'light' : 'dark';
			document.documentElement.dataset.theme = next;
			try {
				// Same key Starlight's ThemeProvider reads, so the choice survives
				// navigation and is applied before first paint on the next page.
				localStorage.setItem('starlight-theme', next);
			} catch {
				// Private-mode storage failures are non-fatal: the theme still
				// applies for this page, it just will not persist.
			}
		});
	});
</script>
