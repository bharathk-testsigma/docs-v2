---
/**
 * Breadcrumbs -- the trail shown in the content top bar.
 *
 * Derived from the sidebar tree for the current route rather than from URL
 * segments: walk to the entry marked isCurrent and collect the group labels on
 * the way. A page whose nav position differs from its file path still gets the
 * right trail that way.
 *
 * The final crumb is the page itself and is not a link.
 */
import type { SidebarEntry } from '@astrojs/starlight/schema';
import { isApiReferencePath } from '../starlightRouteData';

const { entry, sidebar } = Astro.locals.starlightRoute;

function trailTo(entries: SidebarEntry[], acc: string[] = []): string[] | null {
	for (const item of entries) {
		if (item.type === 'link') {
			if (item.isCurrent) return acc;
		} else if (item.type === 'group') {
			const found = trailTo(item.entries, [...acc, item.label]);
			if (found) return found;
		}
	}
	return null;
}

const ancestors = trailTo(sidebar) ?? [];

// The API nav is the API group unwrapped (see starlightRouteData.ts), so
// walking it yields the entity section but not the section it came from. Put
// the root crumb back, otherwise an endpoint page reads "Projects / List
// projects" with nothing saying which reference it belongs to.
const crumbs = [
	...(isApiReferencePath(Astro.url.pathname) ? ['REST APIs'] : []),
	...ancestors,
	entry.data.title,
];
---

<nav class="ts-crumbs" aria-label="Breadcrumb">
	{
		crumbs.map((label, i) => (
			<span class="ts-crumb-part">
				<span class:list={['ts-crumb', { current: i === crumbs.length - 1 }]}>{label}</span>
				{i < crumbs.length - 1 && (
					<svg
						class="ts-crumb-sep"
						width="14"
						height="14"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.7"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<path d="m9 18 6-6-6-6" />
					</svg>
				)}
			</span>
		))
	}
</nav>

<style>
	.ts-crumbs {
		display: flex;
		align-items: center;
		gap: 9px;
		flex-wrap: wrap;
		font-size: 13.5px;
		min-width: 0;
		padding-top: 8px; /* optical centring against the 38px actions control */
	}
	.ts-crumb-part {
		display: flex;
		align-items: center;
		gap: 9px;
	}
	.ts-crumb {
		color: var(--ts-tx3);
		font-weight: 400;
		white-space: nowrap;
	}
	.ts-crumb.current {
		color: var(--ts-tx);
		font-weight: 500;
	}
	.ts-crumb-sep {
		color: var(--ts-tx3);
	}

	/* On narrow screens keep only the current page, so the bar does not wrap
	   under the actions. */
	@media (max-width: 50rem) {
		.ts-crumb-part:not(:last-child) {
			display: none;
		}
	}
</style>
