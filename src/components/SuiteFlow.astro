---
/**
 * The Suite home's journey diagram: one test case moving through five stages,
 * each stage a link into the section that documents it.
 *
 * A component rather than more markup in home.mdx. The diagram is ~120 SVG
 * nodes of pure decoration, and the page body doubles as the source for
 * `/suite/home.md` -- the file an LLM gets from "Copy page" -- so layout that
 * carries no prose is better kept out of it.
 *
 * Hovering (or tabbing to) a stage swaps the caption underneath. That is done
 * with :has() rather than a script: the only state is which stage the pointer
 * is over, which CSS already knows.
 */
const STAGES = [
	{
		label: 'Describe',
		tone: 'var(--ts-tx2)',
		href: '/suite/create-and-manage/create-test-cases/',
		rows: ['Jira story', 'Figma frame', 'Recorder session'],
		foot: 'Plain English, no code',
		cap: 'Describe the flow. A step reads Click on Login Button, so the people who know the app automate it.',
	},
	{
		label: 'Atto generates',
		tone: 'var(--fl-pink)',
		href: '/suite/atto/ai-agents/',
		rows: ['Generator agent', 'Test data profile', 'Step groups'],
		foot: 'Cases, ready to run',
		cap: 'Atto turns a ticket, a design, or a prompt into whole test cases, then automates them against your app.',
	},
	{
		label: 'Run anywhere',
		tone: 'var(--fl-teal)',
		href: '/suite/run-tests/test-plan/',
		rows: ['Web, Android, iOS', 'Salesforce, Windows', 'REST API'],
		foot: 'Parallel cloud grid',
		cap: 'One test plan runs across browsers, real devices, desktop, and APIs, in parallel, with no grid to maintain.',
	},
	{
		label: 'Heal and analyze',
		tone: 'var(--fl-purple)',
		href: '/suite/run-tests/debug/',
		rows: ['Auto-healed locators', 'Analyzer explains', 'Bug Reporter files'],
		foot: 'Fewer red builds',
		cap: 'Auto-healing repairs a moved locator mid-run, and the Analyzer says why a step failed and what to change.',
	},
	{
		label: 'Ship',
		tone: 'var(--fl-green)',
		href: '/suite/integrations/#cicd',
		rows: ['CI/CD gate', 'Run results', 'Coverage dashboard'],
		foot: 'Merge with evidence',
		cap: 'Results land back in the pipeline, so the build fails on a failed run and the merge carries its evidence.',
	},
];

// One 245px column per stage: a 200px card, then the 45px connector to the next.
const STRIDE = 245;
const x = (i: number) => 10 + i * STRIDE;
const cx = (i: number) => x(i) + 100;
---

<div class="fl">
	<div class="fl-scroll">
		<svg
			viewBox="0 0 1200 372"
			role="img"
			aria-label="How a test case moves through Testsigma Suite: describe, Atto generates, run anywhere, heal and analyze, ship"
		>
			{
				/* Connectors, each with a dot travelling in the direction of the work.
				   The dot takes the colour of the stage it is arriving at. */
				STAGES.slice(1).map((s, i) => (
					<Fragment>
						<path id={`fl-e${i}`} class="fl-edge" d={`M ${x(i) + 200} 165 H ${x(i + 1)}`} />
						<circle class="fl-pulse" r="4" style={`fill:${s.tone}`}>
							<animateMotion dur="2.6s" begin={`${i * 0.55}s`} repeatCount="indefinite">
								<mpath href={`#fl-e${i}`} />
							</animateMotion>
							<animate
								attributeName="opacity"
								values="0;1;1;0"
								dur="2.6s"
								begin={`${i * 0.55}s`}
								repeatCount="indefinite"
							/>
						</circle>
					</Fragment>
				))
			}

			{/* Auto-healing is the one stage that feeds back rather than forward. */}
			<path id="fl-loop" class="fl-loop" d="M 845 260 V 320 H 355 V 260" />
			<circle class="fl-pulse" r="3.5" style="fill:var(--fl-purple)">
				<animateMotion dur="4.2s" repeatCount="indefinite"><mpath href="#fl-loop" /></animateMotion>
			</circle>
			<text x="600" y="342" text-anchor="middle" class="fl-loop-t">
				Auto-healing feeds the fix back into the case
			</text>

			{
				STAGES.map((s, i) => (
					<a class="fl-z" id={`fl-z${i + 1}`} href={s.href} style={`--tone:${s.tone}`}>
						<text x={cx(i)} y="56" text-anchor="middle" class="fl-label">
							{s.label}
						</text>
						<rect x={x(i)} y="70" width="200" height="190" rx="16" class="fl-box" />
						{s.rows.map((row, j) => (
							<Fragment>
								<rect x={x(i) + 16} y={92 + j * 42} width="168" height="38" rx="8" class="fl-row" />
								<text x={cx(i)} y={116 + j * 42} text-anchor="middle" class="fl-row-t">
									{row}
								</text>
							</Fragment>
						))}
						<text x={cx(i)} y="243" text-anchor="middle" class="fl-foot">
							{s.foot}
						</text>
					</a>
				))
			}
		</svg>
	</div>

	{/* Stacked in one grid cell so the block never changes height as it swaps. */}
	<p class="fl-cap">
		<span class="fl-cap-d">Five stages, one test case. Hover a stage to see what Suite does there.</span>
		{STAGES.map((s, i) => <span class={`fl-cap-${i + 1}`}>{s.cap}</span>)}
	</p>
</div>

<style>
	.fl {
		/* Stage accents. Dark first, matching theme.css; the light values are the
		   design's. Greys come from the --ts-* tokens, so only these five need a
		   pair. */
		--fl-pink: #e58086;
		--fl-teal: #3fb6bf;
		--fl-purple: #a78bfa;
		--fl-green: #4bbd8a;
	}
	:root[data-theme='light'] .fl {
		--fl-pink: #b2506a;
		--fl-teal: #0b7f88;
		--fl-purple: #5c27f5;
		--fl-green: #00875a;
	}

	/* Below ~800px the 1200-unit viewBox shrinks the labels past legibility, so
	   the diagram scrolls sideways instead of scaling down. */
	.fl-scroll {
		overflow-x: auto;
		scrollbar-width: thin;
	}
	.fl svg {
		display: block;
		width: 100%;
		min-width: 760px;
		height: auto;
	}

	.fl-edge {
		fill: none;
		stroke: var(--ts-bd);
		stroke-width: 1.4;
		stroke-linecap: round;
	}
	.fl-loop {
		fill: none;
		stroke: var(--ts-bd);
		stroke-width: 1.3;
		stroke-dasharray: 5 5;
	}
	.fl-loop-t {
		font-size: 15px;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		fill: var(--ts-tx3);
	}

	/* theme.css underlines every anchor in .sl-markdown-content, and an SVG
	   <text> inherits that from the <a> wrapping it. :global on the outer class
	   because it belongs to the page, not this component. */
	:global(.sl-markdown-content) .fl-z,
	:global(.sl-markdown-content) .fl-z:hover {
		cursor: pointer;
		text-decoration: none;
	}
	.fl-label {
		font-size: 15px;
		font-weight: 700;
		letter-spacing: 0.09em;
		text-transform: uppercase;
		fill: var(--tone);
	}
	.fl-box {
		fill: var(--ts-bg);
		stroke: var(--ts-bd);
		transition: stroke 200ms, fill 200ms;
	}
	.fl-z:hover .fl-box,
	.fl-z:focus-visible .fl-box {
		stroke: var(--tone);
		fill: var(--ts-panel);
	}
	.fl-row {
		fill: var(--ts-panel);
		stroke: var(--ts-bd-soft);
	}
	.fl-row-t {
		font-size: 17px;
		fill: var(--ts-tx2);
	}
	.fl-foot {
		font-size: 15px;
		fill: var(--ts-tx3);
	}

	.fl-cap {
		display: grid;
		margin: 18px auto 0;
		max-width: 70ch;
		text-align: center;
		font-size: 14.5px;
		line-height: 23px;
		color: var(--ts-tx2);
		text-wrap: pretty;
	}
	.fl-cap > span {
		grid-area: 1 / 1;
		opacity: 0;
		transition: opacity 150ms;
	}
	/* Outranks the reset above, which is (0,1,1) on .fl-cap > span. */
	.fl-cap > .fl-cap-d {
		opacity: 1;
	}
	.fl:has(.fl-z:is(:hover, :focus-visible)) .fl-cap-d {
		opacity: 0;
	}
	.fl:has(#fl-z1:is(:hover, :focus-visible)) .fl-cap-1,
	.fl:has(#fl-z2:is(:hover, :focus-visible)) .fl-cap-2,
	.fl:has(#fl-z3:is(:hover, :focus-visible)) .fl-cap-3,
	.fl:has(#fl-z4:is(:hover, :focus-visible)) .fl-cap-4,
	.fl:has(#fl-z5:is(:hover, :focus-visible)) .fl-cap-5 {
		opacity: 1;
	}

	@media (prefers-reduced-motion: reduce) {
		.fl-pulse {
			display: none;
		}
	}
</style>
