const maskUrl = (inner: string) =>
	`url("data:image/svg+xml,${encodeURIComponent(
		`<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'>${inner}</svg>`
	)}")`;

// Geometry lives here, not in theme.css: a blanket `::before` rule for icons
// also matches the current-page bar (also a `::before`) when an entry IS the
// current page, and repainted it as a square.
const iconRule = (selector: string, shape: string) => {
	const url = maskUrl(shape);
	// `margin-top: 2px` = (20px line - 16px glyph) / 2. Rows align to flex-start
	// so a wrapping label keeps its glyph on the first line; this offset centres
	// the glyph against that line, so a one-line row is unchanged.
	// Opacity is the only tint available -- the glyph is painted with the row's
	// own currentColor. Below ~.7 these read as disabled rather than quiet.
	return `${selector}::before{content:'';width:16px;height:16px;margin-top:2px;flex:none;opacity:.75;background:currentColor;-webkit-mask:center / contain no-repeat;mask:center / contain no-repeat;-webkit-mask-image:${url};mask-image:${url};}`;
};

// The top-of-rail utility rows (Home / API Reference / Changelog) carry a
// FRAMED icon: the glyph sits inside a rounded square, the way the reference
// draws its standalone links.
//
// Two pseudo-elements, not one mask carrying both shapes: the frame has to
// take the rail's own hover fill while the glyph keeps the row's ink, and a
// single element can only paint one colour (a mask also clips a CSS border
// away). So theme.css draws the frame as a real bordered box on the row's
// `::before`, and this rule floats the glyph over it from the label span --
// `left: 12px` is the anchor's own padding, and the box centres on the same
// line, so the two land on top of each other without either knowing the
// other's geometry.
const glyphRule = (selector: string, shape: string) => {
	const url = maskUrl(shape);
	return `${selector} > span::before{content:'';position:absolute;left:12px;top:50%;width:22px;height:22px;transform:translateY(-50%);opacity:.8;background:currentColor;-webkit-mask:center / 12px no-repeat;mask:center / 12px no-repeat;-webkit-mask-image:${url};mask-image:${url};}`;
};

const navIconCss = isApiReference
	? ''
	: Astro.locals.starlightRoute.sidebar
			.flatMap((entry, i) => {
				const at = `#starlight__sidebar ul.top-level > li:nth-child(${i + 1})`;
				const rules: string[] = [];

				const l1 = L1_ICONS[entry.label];
				if (l1) {
					// The utility rows opt into the framed treatment via their own attr,
					// set in the sidebar data: their glyph floats over a bordered box
					// instead of sitting inline as a bare 16px mark.
					const utility =
						entry.type === 'link' && entry.attrs?.['data-nav-utility'] !== undefined;
					if (utility) {
						rules.push(glyphRule(`${at} > a.large`, l1));
					} else {
						// A section is usually a group (details > summary), but a single-page
						// section is a bare top-level link -- same icon treatment for both.
						rules.push(
							iconRule(
								`${at} ${entry.type === 'group' ? '> details > summary .group-label' : '> a.large'}`,
								l1
							)
						);
					}
				}

				return rules;
			})
			.join('\n');
---

<div class="ts-rail" data-api-nav={isApiReference ? 'true' : undefined}>
	<Default><slot /></Default>
</div>

{
	/*
	  Keep the rail's scroll position across navigations.

	  Starlight already does this -- but against `#starlight__sidebar`, which in
	  this layout does not scroll (`.sidebar-content` inside it owns the
	  overflow). It therefore saved and restored 0 every time, and a reader who
	  opened a group deep in the tree was thrown back to the first fold by the
	  very click that navigated. Starlight's <details> open/closed persistence is
	  unaffected; only the offset is re-pointed here.

	  Inline and placed after the tree so it runs during parsing, before the
	  first paint -- restoring in a later event would show the jump it prevents.
	*/
}
<script is:inline>
	(() => {
		try {
			// Mobile renders the rail as a drawer that opens at the top, so there is
			// no offset worth carrying. Same guard Starlight uses.
			if (!matchMedia('(min-width: 50em)').matches) return;
			const nav = document.querySelector('.sidebar-content');
			if (!nav) return;
			const KEY = 'ts-sidebar-scroll';
			// Reuse Starlight's own tree hash, so an offset saved in one tree is
			// never applied to another (the docs tree and the API reference render
			// a different nav).
			const hash = nav.querySelector('sl-sidebar-state-persist')?.dataset.hash || '';
			// Leaving a page collapses the group that was auto-expanded around it,
			// so the tree can get shorter above the restored offset and carry the
			// current page's row off the top. Nudge it back into view -- this also
			// covers arriving with no saved offset at all (a search hit or an
			// external link deep in the tree), where the row would sit unseen below
			// the fold.
			const showCurrent = () => {
				const cur = nav.querySelector('a[aria-current="page"]');
				if (!cur) return;
				const n = nav.getBoundingClientRect();
				const r = cur.getBoundingClientRect();
				const pad = 24;
				if (r.top < n.top) nav.scrollTop -= n.top - r.top + pad;
				else if (r.bottom > n.bottom) nav.scrollTop += r.bottom - n.bottom + pad;
			};

			const saved = JSON.parse(sessionStorage.getItem(KEY) || 'null');
			const restore = () => {
				if (saved && saved.hash === hash) nav.scrollTop = saved.top;
				showCurrent();
			};
			restore();
			// If the tree was not laid out yet, the assignment above clamped to 0;
			// take a second pass once parsing is done.
			if (saved && saved.hash === hash && nav.scrollTop === 0 && saved.top !== 0) {
				addEventListener('DOMContentLoaded', restore);
			}
			const save = () => {
				try {
					sessionStorage.setItem(KEY, JSON.stringify({ hash, top: nav.scrollTop }));
				} catch {}
			};
			// A click inside the nav IS the navigation, so record the offset then.
			nav.addEventListener('click', save);
			// Covers keyboard activation and anything else that leaves the page.
			// `visibilitychange` rather than `beforeunload`, which breaks bfcache.
			addEventListener('visibilitychange', () => {
				if (document.visibilityState === 'hidden') save();
			});
		} catch {}
	})();
</script>

{navIconCss && <style is:inline set:html={navIconCss} />}

<style>
	.ts-rail {
		width: 100%;
	}

</style>
