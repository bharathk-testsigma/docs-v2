---
/**
 * Sidebar override -- gives the left nav its own header, the way Linear's
 * docs do.
 *
 * Starlight's default layout puts one full-width header across the top, with
 * the sidebar starting beneath it. Linear instead lets the sidebar own the
 * full height of the viewport: the wordmark and search sit at the top of the
 * sidebar and the nav scrolls beneath them. The breadcrumbs, section links, and
 * page actions live in a top bar inside the content column (see Header.astro).
 *
 * The nav list itself is Starlight's own Sidebar, rendered unchanged, so
 * collapsible groups, the current-page marker, and state persistence across
 * navigations all keep working.
 *
 * Section links are NOT here -- they live in the content top bar
 * (Header.astro), at the top of the page.
 */
import Default from '@astrojs/starlight/components/Sidebar.astro';
// Forked Search (not Starlight's): identical dialog, but also works in dev.
import Search from './Search.astro';
import ProductSwitcher from './ProductSwitcher.astro';
import { isApiReferencePath } from '../starlightRouteData';

// Search is Starlight's own Pagefind dialog, rendered here instead of in the
// header (this layout has no full-width header). The same dialog carries the
// Ask Assistant tab; the top bar's Ask button opens it in that mode.

// On API reference pages the nav holds only the endpoint groups (the route
// middleware does the swap). The marker below is what theme.css keys the
// API-nav treatment off: method chip before the label, flat section headings.
const isApiReference = isApiReferencePath(Astro.url.pathname);

// ---- L1 section icons ----
// Starlight renders group labels as plain text, so the icon can't go in the
// sidebar data. Instead: the middleware has already fixed this URL's top-level
// order, so each section's icon is emitted as an nth-child mask rule against
// the same tree Starlight is about to render. Keyed by label -- a section with
// no entry simply gets no icon, which also keeps the API entity groups clean
// (they're skipped wholesale below anyway, since e.g. "Test Cases" is both an
// Arcus section and a Suite API entity).
// Icon shapes are Lucide outlines (24x24 grid, stroke 2).
const L1_ICONS: Record<string, string> = {
