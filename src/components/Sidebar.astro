---
/**
 * Sidebar override -- the V4 left rail.
 *
 * The rail is nav ONLY: the brand, product switcher and search all live in the
 * top bar now (Header.astro), so this component renders Starlight's own
 * sidebar tree unchanged -- collapsible groups, the current-page marker and
 * state persistence all keep working -- plus the one thing Starlight has no
 * concept of: the L1 section icons.
 *
 * No API version selector: v2 endpoints live beside their v1 twins with a
 * "(v2)" label, so there is nothing to switch between.
 *
 * All of the rail's visual treatment lives in theme.css under "rail", because
 * it styles Starlight's own markup rather than anything emitted here.
 */
import Default from '@astrojs/starlight/components/Sidebar.astro';
import { isApiReferencePath } from '../starlightRouteData';

// On API reference pages the nav holds only the endpoint groups (the route
// middleware does the swap). The marker below is what theme.css keys the
// API-nav treatment off: method chip before the label, ellipsised rows.
const isApiReference = isApiReferencePath(Astro.url.pathname);

// ---- L1 section icons ----
// Starlight renders group labels as plain text, so the icon can't go in the
// sidebar data. Instead: the middleware has already fixed this URL's top-level
// order, so each section's icon is emitted as an nth-child mask rule against
// the same tree Starlight is about to render. Keyed by label -- a section with
// no entry simply gets no icon, which also keeps the API entity groups clean
// (they're skipped wholesale below anyway).
// Icon shapes are Lucide outlines (24x24 grid, stroke 2).
