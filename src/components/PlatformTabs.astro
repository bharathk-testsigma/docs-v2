---
/**
 * PlatformTabs -- one component for BOTH multi-language code samples and
 * multi-platform step syntax (Web / Mobile / Salesforce / Windows).
 *
 * Ported from the design project's `astro/PlatformTabs.astro`. Two changes:
 *  - `var(--ts-label-grey)` in the source is not defined anywhere in the design
 *    system or the page; replaced with `--ts-tx3`, the design's muted text token.
 *  - `Math.random()` for the uid is replaced with a module-scoped counter, so the
 *    same page produces the same HTML on every build (a random id defeats
 *    Astro's build caching and makes output diffs noisy).
 *
 * This is the component that satisfies the "platforms are tabs, not separate
 * nav branches" IA rule: content that differs only by platform lives on ONE
 * page behind these tabs instead of being forked into five near-identical pages.
 *
 * Requires .mdx, not .md.
 *
 *   import PlatformTabs from '../../../components/PlatformTabs.astro';
 *
 *   <PlatformTabs tabs={['Web', 'Android', 'iOS']} sync="platform">
 *     <Fragment slot="tab-0">...</Fragment>
 *     <Fragment slot="tab-1">...</Fragment>
 *   </PlatformTabs>
 *
 * `sync` groups tab sets across the page AND across page loads: picking
 * "Android" once keeps every synced tab set on Android (persisted in
 * localStorage), so a mobile reader never re-picks their platform per section.
 */
interface Props {
	tabs: string[];
	/** Sync key -- tab sets sharing a key switch together and persist. */
	sync?: string;
	/** Optional label above the tab row, e.g. "Choose your platform". */
	label?: string;
}

const { tabs, sync, label } = Astro.props;

let counter = 0;
const uid = 'pt-' + (++counter).toString(36) + '-' + tabs.join('').toLowerCase().replace(/[^a-z0-9]/g, '').slice(0, 12);
---

<div class="ts-tabs" data-ts-tabs data-sync={sync}>
	{label && <p class="ts-tabs-label">{label}</p>}

	{/* `not-content` opts the buttons out of Starlight's sibling-margin rules,
	    which otherwise push every tab after the first 1rem down. Panels stay
	    outside it so their markdown keeps content styling. */}
	<div class="ts-tabs-row not-content" role="tablist" aria-label={label ?? 'Platform'}>
		{
			tabs.map((t, i) => (
				<button
					class="ts-tab"
					role="tab"
					type="button"
					id={`${uid}-t${i}`}
					data-value={t}
					aria-controls={`${uid}-p${i}`}
					aria-selected={i === 0 ? 'true' : 'false'}
					tabindex={i === 0 ? 0 : -1}
				>
					{t}
				</button>
			))
		}
	</div>

	{
		tabs.map((t, i) => (
			<div
				class="ts-tab-panel"
				role="tabpanel"
				id={`${uid}-p${i}`}
				aria-labelledby={`${uid}-t${i}`}
				data-value={t}
				hidden={i !== 0}
			>
				<slot name={`tab-${i}`} />
			</div>
		))
	}
</div>

<style>
	.ts-tabs {
		margin: 0 0 1.5rem;
	}

	.ts-tabs-label {
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--ts-tx3);
		margin: 0 0 8px;
	}

	/* inline-flex + max-content shrink-wraps the row, so the hairline ends at
	   the last tab instead of running the content width (same treatment as the
	   starlight-tabs restyle in theme.css). */
	.ts-tabs-row {
		display: inline-flex;
		width: max-content;
		max-width: 100%;
		gap: 22px;
		border-bottom: 1px solid var(--ts-bd);
		margin-bottom: 0.65rem;
		overflow-x: auto;
		scrollbar-width: none;
	}
	.ts-tabs-row::-webkit-scrollbar {
		display: none;
	}

	.ts-tab {
		flex: none;
		/* Near-zero horizontal padding: the row's hairline ends 2px after the
		   last label instead of a full pad-width later; the 22px gap does the
		   spacing (same geometry as the starlight-tabs restyle in theme.css). */
		padding: 7px 2px;
		border: none;
		background: transparent;
		font: inherit;
		font-size: 0.844rem; /* 13.5px, matches body */
		font-weight: 500;
		line-height: 1.3;
		color: var(--ts-tx2);
		cursor: pointer;
		border-bottom: 2px solid transparent;
		margin-bottom: -1px;
		white-space: nowrap;
		transition: color 140ms cubic-bezier(0.2, 0.8, 0.2, 1);
	}
	.ts-tab:hover {
		color: var(--ts-tx);
	}

	/* The design underlines the active tab in the primary text colour, not the
	   accent -- see `tabStyle(on)` in the canvas source. */
	.ts-tab[aria-selected='true'] {
		font-weight: 650;
		color: var(--ts-tx);
		border-bottom-color: var(--ts-tx);
	}

	.ts-tab:focus-visible {
		outline: 2px solid var(--ts-ac);
		outline-offset: -2px;
		border-radius: 4px 4px 0 0;
	}

	/* Collapse the gap a markdown block would otherwise add at the panel top.
	   The panel div itself also needs it: Starlight's sibling-margin rule gives
	   it 1rem on top of the row's margin-bottom. */
	.ts-tab-panel {
		margin-top: 0;
	}
	.ts-tab-panel > :global(:first-child) {
		margin-top: 0;
	}
</style>

<script>
	const KEY = (sync: string) => `ts-tabs:${sync}`;

	function select(root: HTMLElement, value: string, focus = false) {
		const tabs = [...root.querySelectorAll<HTMLButtonElement>('.ts-tab')];
		const panels = [...root.querySelectorAll<HTMLElement>('.ts-tab-panel')];
		const idx = tabs.findIndex((t) => t.dataset.value === value);
		if (idx === -1) return;

		tabs.forEach((t, i) => {
			const on = i === idx;
			t.setAttribute('aria-selected', String(on));
			t.tabIndex = on ? 0 : -1;
			if (on && focus) t.focus();
		});
		panels.forEach((p, i) => {
			p.hidden = i !== idx;
		});
	}

	document.querySelectorAll<HTMLElement>('[data-ts-tabs]').forEach((root) => {
		const sync = root.dataset.sync;
		const tabs = [...root.querySelectorAll<HTMLButtonElement>('.ts-tab')];

		// Restore the reader's previous choice for this sync group.
		if (sync) {
			const saved = localStorage.getItem(KEY(sync));
			if (saved) select(root, saved);
		}

		tabs.forEach((tab) => {
			tab.addEventListener('click', () => {
				const value = tab.dataset.value!;
				if (sync) {
					localStorage.setItem(KEY(sync), value);
					// Move every synced tab set on the page in lockstep.
					document
						.querySelectorAll<HTMLElement>(`[data-ts-tabs][data-sync="${sync}"]`)
						.forEach((peer) => select(peer, value));
				} else {
					select(root, value);
				}
			});

			// Roving-tabindex keyboard nav, per the WAI-ARIA tabs pattern.
			tab.addEventListener('keydown', (e) => {
				const i = tabs.indexOf(tab);
				let next = -1;
				if (e.key === 'ArrowRight') next = (i + 1) % tabs.length;
				if (e.key === 'ArrowLeft') next = (i - 1 + tabs.length) % tabs.length;
				if (e.key === 'Home') next = 0;
				if (e.key === 'End') next = tabs.length - 1;
				if (next === -1) return;
				e.preventDefault();
				tabs[next].click();
				tabs[next].focus();
			});
		});
	});
</script>
