---
/**
 * Footer override -- the page-feedback row, then Starlight's footer.
 *
 * Feedback comes FIRST so it sits above the prev/next pagination, per the
 * reference: the reader rates the page they just read, then moves on. The
 * default footer is rendered unchanged below it (pagination, edit link, last
 * updated), so nothing is lost.
 *
 * Also carries GTM's <noscript> fallback: it is an <iframe>, so it cannot go in
 * the `head` config next to the loader script -- this is the one override that
 * renders in <body> on every page. Position within <body> is irrelevant to it.
 */
import Default from '@astrojs/starlight/components/Footer.astro';
import PageFeedback from './PageFeedback.astro';
---

<PageFeedback />
<Default><slot /></Default>

<noscript
	><iframe
		src="https://www.googletagmanager.com/ns.html?id=GTM-5F8HTVT"
		height="0"
		width="0"
		style="display:none;visibility:hidden"></iframe></noscript
>
