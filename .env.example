# Ask AI (optional).
#
# Copy this file to `.env` and fill in both keys to enable the Ask AI drawer
# (the "Ask" button in the top bar). WITHOUT them the button still opens the
# drawer, but answers fall back to Pagefind keyword search — the site itself
# never breaks.
#
# Both keys are SERVER-side only (no PUBLIC_ prefix): they are read by
# api/ask.ts and scripts/build-ask-index.mjs, never shipped to the browser.
#
#   ANTHROPIC_API_KEY  — LiteLLM gateway key (direct Anthropic keys are disabled).
#                        Used for BOTH embeddings and answers.
#   ANTHROPIC_BASE_URL — the LiteLLM gateway host,
#                        e.g. https://ai-gateway-staging.testsigma.com
#   VOYAGE_API_KEY     — rerank only, from https://dashboard.voyageai.com
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
VOYAGE_API_KEY=

# Origin serving the two Ask functions (api/ask, api/ask-feedback).
#
# Leave EMPTY where the functions are deployed alongside the static output --
# Vercel, and `npm run dev:ask` locally -- so the drawer calls them same-origin.
#
# Set it for the httpd/EKS deployments (staging + production), which ship dist/
# and nothing else: there, a same-origin /api/ask escapes the /docs-new/ prefix
# the website's Apache proxies here, reaches the WEBSITE's own API router, and
# comes back 400. Point this at a deployment that runs the handlers instead:
#
#   PUBLIC_ASK_API_ORIGIN=https://<the-vercel-deployment>
#
# PUBLIC_ because it is read in browser code and must be inlined at build time;
# it is a URL, not a credential. In CI it is set per environment from the
# repository variables ASK_API_ORIGIN_STAGING / ASK_API_ORIGIN_PRODUCTION -- see
# .github/workflows/manual.yml. Unset there simply restores the same-origin
# behaviour, so a missing variable degrades to the old state rather than to a
# broken build.
PUBLIC_ASK_API_ORIGIN=

# In CI these come from GitHub repository secrets of the same names, not from a
# .env file — the npm scripts use `--env-file-if-exists`, so they read .env when
# it is present and plain environment variables otherwise.

# Build the retrieval index (writes public/ask-index.bin + .meta.json, both
# committed) whenever docs content changes:
#   npm run build:ask-index
#
# In CI this is done by .github/workflows/ask-index.yml, which reads the secrets
# above and commits the regenerated files. The deploy workflow never rebuilds it.
#
# Full local run (static site + real streaming API at /api/ask):
#   npm run build && npm run dev:ask
#
# Deployed on Vercel: api/ask.ts runs as a serverless function (see
# vercel.json); set both env vars in the Vercel project settings.
